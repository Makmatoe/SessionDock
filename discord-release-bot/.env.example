# Found on the Discord Developer Portal's General Information page.
DISCORD_CLIENT_ID=

# Found on the Bot page. Never commit or share this value.
DISCORD_TOKEN=

# Optional: use one server while testing so command changes appear immediately.
# Remove this value and run `npm run community:deploy` again to install the optional command globally.
DISCORD_GUILD_ID=

# Optional announcement styling.
RELEASE_EMBED_COLOR="#5865F2"
RELEASE_FOOTER=Community update

# Discord caps the whole message request at 25 MiB. Keep some room for payload data.
MAX_TOTAL_IMAGE_MB=20
