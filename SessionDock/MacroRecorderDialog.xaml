<Window x:Class="SessionDock.MacroRecorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Macro.RecordTitle}"
        Width="540" SizeToContent="Height" MaxHeight="760"
        MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{DynamicResource Macro.RecordHeading}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Macro.RecordDescription}"
                       Margin="0,5,0,0"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="{DynamicResource Macro.NameLabel}"
                       Foreground="{DynamicResource SubtleBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <TextBox x:Name="NameTextBox"
                     Margin="0,6,0,0" MinHeight="38" MaxLength="80"
                     AutomationProperties.Name="{DynamicResource Macro.NameLabel}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource Macro.ModeLabel}"
                       Foreground="{DynamicResource SubtleBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <Border Margin="0,6,0,0" Padding="12"
                    Background="{DynamicResource WorkspaceSurfaceBrush}"
                    BorderBrush="{DynamicResource WorkspaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <StackPanel>
                    <RadioButton x:Name="ClientModeRadioButton"
                                 GroupName="RecordingMode" IsChecked="True"
                                 Content="{DynamicResource Macro.ModeClient}"
                                 AutomationProperties.Name="{DynamicResource Macro.ModeClient}"
                                 AutomationProperties.HelpText="{DynamicResource Macro.ModeClientHelp}"/>
                    <TextBlock Text="{DynamicResource Macro.ModeClientHelp}"
                               Margin="26,3,0,10"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                    <RadioButton x:Name="WholeLayoutModeRadioButton"
                                 GroupName="RecordingMode"
                                 Content="{DynamicResource Macro.ModeWholeLayout}"
                                 AutomationProperties.Name="{DynamicResource Macro.ModeWholeLayout}"
                                 AutomationProperties.HelpText="{DynamicResource Macro.ModeWholeLayoutHelp}"/>
                    <TextBlock Text="{DynamicResource Macro.ModeWholeLayoutHelp}"
                               Margin="26,3,0,0"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{DynamicResource Macro.TargetLabel}"
                       Foreground="{DynamicResource SubtleBrush}"
                       FontSize="11" FontWeight="SemiBold"/>
            <ComboBox x:Name="TargetComboBox"
                      Margin="0,6,0,0" MinHeight="38"
                      DisplayMemberPath="DisplayName"
                      AutomationProperties.Name="{DynamicResource Macro.TargetLabel}"/>
        </StackPanel>

        <Border Grid.Row="4" Margin="0,16,0,0" Padding="12"
                Background="{DynamicResource WarningSurfaceBrush}"
                BorderBrush="{DynamicResource WarningBorderBrush}"
                BorderThickness="1" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="{DynamicResource Macro.PrivacyTitle}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Macro.PrivacyWarning}"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="StatusText"
                       Text="{DynamicResource Macro.StatusReady}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Grid.Row="1" Margin="0,14,0,0"
                        Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton"
                        Content="{DynamicResource Macro.Cancel}"
                        Click="CancelButton_Click"
                        IsCancel="True" Padding="14,8" Margin="0,0,8,0"/>
                <Button x:Name="StopButton"
                        Content="{DynamicResource Macro.Stop}"
                        Click="StopButton_Click"
                        PreviewMouseLeftButtonDown="StopButton_PreviewMouseLeftButtonDown"
                        IsEnabled="False" Padding="14,8" Margin="0,0,8,0"
                        AutomationProperties.Name="{DynamicResource Macro.Stop}"
                        AutomationProperties.HelpText="{DynamicResource Macro.StopHelp}"/>
                <Button x:Name="StartButton"
                        Content="{DynamicResource Macro.Start}"
                        Click="StartButton_Click"
                        IsDefault="True" Padding="16,8"
                        AutomationProperties.Name="{DynamicResource Macro.Start}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
