<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SessionDock</AssemblyName>
    <RootNamespace>SessionDock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SessionDock.ico</ApplicationIcon>
    <StartupObject>SessionDock.Program</StartupObject>
    <Version>2.7.0</Version>
    <Product>SessionDock</Product>
    <Authors>Makmatoe</Authors>
    <Copyright>Copyright (c) 2026 Makmatoe</Copyright>
    <RepositoryUrl>https://github.com/Makmatoe/SessionDock</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <NoWarn>$(NoWarn);CA1001;CA1305;CA1822;CA1859</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableRuntimeSmokeHarness)' == 'true'">
    <DefineConstants>$(DefineConstants);SESSIONDOCK_SMOKE_HARNESS</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**\*.cs" />
    <Compile Remove="Services\RuntimeSmokeTestOptions.cs" />
    <Compile Include="Services\RuntimeSmokeTestOptions.cs"
             Condition="'$(EnableRuntimeSmokeHarness)' == 'true'" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <ProjectReference Include="..\SessionDock.ReleaseTrust\SessionDock.ReleaseTrust.csproj" />
    <None Update="handlescope.example.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
    <None Include="..\LICENSE.md"
          Link="LICENSE.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\licenses\Velopack-LICENSE.txt"
          Link="licenses\Velopack-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64\10.0.10\LICENSE.TXT"
          Link="licenses\DotNet-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.netcore.app.runtime.win-x64\10.0.10\THIRD-PARTY-NOTICES.TXT"
          Link="licenses\DotNet-THIRD-PARTY-NOTICES.txt"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x64\10.0.10\LICENSE"
          Link="licenses\Microsoft.WindowsDesktop-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4078.44\LICENSE.txt"
          Link="licenses\Microsoft.Web.WebView2-LICENSE.txt"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(NuGetPackageRoot)microsoft.web.webview2\1.0.4078.44\NOTICE.txt"
          Link="licenses\Microsoft.Web.WebView2-NOTICE.txt"
          CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\update-public-key.pem"
                      LogicalName="SessionDock.Embedded.ReleasePublicKey.pem" />
    <EmbeddedResource Include="Resources\handlescope-release-public-keys.json"
                      Condition="Exists('Resources\handlescope-release-public-keys.json')"
                      LogicalName="SessionDock.Embedded.HandleScopeReleasePublicKeys.json" />
    <EmbeddedResource Include="ReleaseNotes\*.md"
                      LogicalName="SessionDock.Embedded.ReleaseNotes.%(Filename)%(Extension)" />
    <None Update="Assets\SessionDock.ico"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="Never" />
    <None Remove="Assets\SessionDock.Icon.png" />
    <Resource Include="Assets\SessionDock.Icon.png"
              CopyToOutputDirectory="Never"
              CopyToPublishDirectory="Never" />
  </ItemGroup>

  <Target Name="RemovePublishDocumentation" AfterTargets="Publish">
    <ItemGroup>
      <PublishDocumentation Include="$(PublishDir)*.xml" />
    </ItemGroup>
    <Delete Files="@(PublishDocumentation)" />
  </Target>
</Project>
