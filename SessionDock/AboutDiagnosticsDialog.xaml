<Window x:Class="SessionDock.AboutDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource About.Title}" Width="720" Height="680"
        MinWidth="520" MinHeight="500"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True" ShowInTaskbar="False"
            AutomationProperties.Name="{DynamicResource About.AutomationName}">
    <Border Style="{StaticResource DialogShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource AccentBrush}"
                        Margin="0,0,13,0">
                    <TextBlock Text="SD"
                               Foreground="{DynamicResource OnAccentTextBrush}"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource About.Heading}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="{DynamicResource About.Subtitle}"
                               Foreground="{DynamicResource SubtleBrush}"
                               FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,12" Padding="12,10"
                    Background="{DynamicResource InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconLock}"
                          Width="15" Height="15" Stretch="Uniform"
                          Fill="Transparent"
                          Stroke="{DynamicResource InfoTextBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource About.SafeHeading}"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                       Text="{DynamicResource About.SafeDetail}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{DynamicResource About.PreviewLabel}"
                           Foreground="{DynamicResource SubtleBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="2,0,0,6"/>
                <Border Grid.Row="1" Padding="10"
                        Background="{DynamicResource InsetSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="9">
                    <TextBox x:Name="DiagnosticsPreviewBox"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             Padding="2" Foreground="{DynamicResource TextBrush}"
                             FontFamily="Consolas"
                             FontSize="11" TextBlock.LineHeight="17"
                         AutomationProperties.Name="{DynamicResource About.PreviewName}"
                         AutomationProperties.HelpText="{DynamicResource About.PreviewHelp}"/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionStatusText"
                               Text="{DynamicResource About.NotSent}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyButton"
                        Content="{DynamicResource About.Copy}"
                            Padding="14,9" Margin="0,0,8,0"
                            Click="CopyButton_Click"
                        AutomationProperties.Name="{DynamicResource About.CopyName}"
                        AutomationProperties.HelpText="{DynamicResource About.CopyHelp}"/>
                    <Button x:Name="ExportButton"
                        Content="{DynamicResource About.Export}"
                            Padding="14,9" Margin="0,0,8,0"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            Click="ExportButton_Click"
                        AutomationProperties.Name="{DynamicResource About.ExportName}"
                        AutomationProperties.HelpText="{DynamicResource About.ExportHelp}"/>
                <Button x:Name="DoneButton" Content="{DynamicResource Common.Done}"
                            IsCancel="True" Padding="15,9"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                        AutomationProperties.Name="{DynamicResource About.CloseName}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
