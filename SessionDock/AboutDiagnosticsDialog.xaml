<Window x:Class="SessionDock.AboutDiagnosticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About and diagnostics" Width="720" Height="680"
        MinWidth="520" MinHeight="500"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True" ShowInTaskbar="False"
        AutomationProperties.Name="About SessionDock and privacy-safe diagnostics">
    <Border Style="{StaticResource DialogShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource AccentBrush}"
                        Margin="0,0,13,0">
                    <TextBlock Text="SD"
                               Foreground="{DynamicResource OnAccentTextBrush}"
                               FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="About SessionDock"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="23" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VersionText"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock Text="Local Roblox session launcher - MIT licensed"
                               Foreground="{DynamicResource SubtleBrush}"
                               FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,16,0,12" Padding="12,10"
                    Background="{DynamicResource InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="25"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="{StaticResource IconLock}"
                          Width="15" Height="15" Stretch="Uniform"
                          Fill="Transparent"
                          Stroke="{DynamicResource InfoTextBrush}"
                          StrokeThickness="1.8"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          StrokeLineJoin="Round"
                          VerticalAlignment="Top"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Safe to review before sharing"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource InfoTextBrush}"
                                   FontSize="11" TextWrapping="Wrap"
                                   Text="This preview contains versions, component states, bounded counts, and basic preferences only. It excludes account details, destinations, server or private codes, local paths, browser data, cookies, tokens, URLs, configuration files, logs, and error details."/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="DIAGNOSTICS PREVIEW"
                           Foreground="{DynamicResource SubtleBrush}"
                           FontSize="10" FontWeight="SemiBold"
                           Margin="2,0,0,6"/>
                <Border Grid.Row="1" Padding="10"
                        Background="{DynamicResource InsetSurfaceBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="9">
                    <TextBox x:Name="DiagnosticsPreviewBox"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="NoWrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="Transparent" BorderThickness="0"
                             Padding="2" Foreground="{DynamicResource TextBrush}"
                             FontFamily="Consolas"
                             FontSize="11" TextBlock.LineHeight="17"
                             AutomationProperties.Name="Privacy-safe diagnostics preview"
                             AutomationProperties.HelpText="Review the complete text that Copy diagnostics and Export text file will use."/>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ActionStatusText"
                           Text="Nothing is sent automatically."
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,14,0"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CopyButton"
                            Content="Copy diagnostics"
                            Padding="14,9" Margin="0,0,8,0"
                            Click="CopyButton_Click"
                            AutomationProperties.Name="Copy privacy-safe diagnostics"
                            AutomationProperties.HelpText="Copies exactly the diagnostics preview to the clipboard."/>
                    <Button x:Name="ExportButton"
                            Content="Export text file"
                            Padding="14,9" Margin="0,0,8,0"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            Click="ExportButton_Click"
                            AutomationProperties.Name="Export privacy-safe support diagnostics"
                            AutomationProperties.HelpText="Choose where to save exactly the diagnostics preview as a text file."/>
                    <Button x:Name="DoneButton" Content="Done"
                            IsCancel="True" Padding="15,9"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            AutomationProperties.Name="Close about and diagnostics"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
