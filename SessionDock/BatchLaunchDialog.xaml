<Window x:Class="SessionDock.BatchLaunchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Batch.Title}" Width="680" Height="720"
        MinWidth="560" MinHeight="520"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Border Style="{StaticResource DialogShell}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="DialogTitleText" Text="{DynamicResource Batch.Title}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="DialogIntroText"
                           Text="{DynamicResource Batch.Detail}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="13"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="CloseClientsWarningText"
                           Text="{DynamicResource Batch.Warning}"
                           Foreground="{DynamicResource WarningTextBrush}"
                           FontSize="12" FontWeight="SemiBold"
                           Margin="0,9,0,0" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Batch.Verification}"
                           Foreground="{DynamicResource MutedBrush}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <Border x:Name="PresetsPanel" Grid.Row="1" Margin="0,18,0,0"
                    Background="{DynamicResource InsetSurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal">
                        <TextBlock Text="{DynamicResource Batch.Presets}"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="PresetCountText"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" Margin="8,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <ComboBox x:Name="PresetComboBox" Grid.Row="1"
                              Height="38" Margin="0,9,8,0"
                              DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="{DynamicResource Batch.PresetName}"
                              AutomationProperties.HelpText="{DynamicResource Batch.PresetHelp}"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="{DynamicResource Common.Load}"
                            Click="LoadPresetButton_Click"
                            Margin="0,9,8,0" Padding="12,7"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            AutomationProperties.Name="{DynamicResource Batch.LoadPresetName}"/>
                    <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Common.Delete}"
                            Click="DeletePresetButton_Click"
                            Margin="0,9,0,0" Padding="12,7"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            AutomationProperties.Name="{DynamicResource Batch.DeletePresetName}"/>

                    <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Height="38" Style="{StaticResource TextFieldShell}">
                            <TextBox x:Name="PresetNameBox" MaxLength="40"
                                     Style="{StaticResource EmbeddedTextBox}"
                                     AutomationProperties.Name="{DynamicResource Batch.NewPresetName}"
                                     AutomationProperties.HelpText="{DynamicResource Batch.NewPresetHelp}"/>
                        </Border>
                        <Button Grid.Column="1" Content="{DynamicResource Batch.SaveCurrent}"
                                Click="SavePresetButton_Click"
                                Margin="8,0,0,0" Padding="14,7"
                                AutomationProperties.Name="{DynamicResource Batch.SaveCurrentName}"/>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,18,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Batch.Accounts}"
                           Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                           FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ComboBox x:Name="GroupComboBox" Width="150" Height="34"
                              Margin="0,0,6,0" DisplayMemberPath="Name"
                              VerticalContentAlignment="Center"
                              AutomationProperties.Name="{DynamicResource Batch.GroupName}"
                              AutomationProperties.HelpText="{DynamicResource Batch.GroupHelp}"/>
                    <Button Content="{DynamicResource Batch.SelectGroup}" Click="SelectGroupButton_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource InfoTextBrush}"
                            Padding="8,4" FontSize="12"
                            AutomationProperties.Name="{DynamicResource Batch.SelectGroupName}"/>
                    <Button Content="{DynamicResource Common.All}" Click="SelectAllButton_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource InfoTextBrush}"
                            Padding="8,4" FontSize="12"
                            AutomationProperties.Name="{DynamicResource Batch.SelectAllName}"/>
                    <Button Content="{DynamicResource Common.None}" Click="SelectNoneButton_Click"
                            Background="Transparent"
                            Foreground="{DynamicResource SubtleBrush}"
                            Padding="8,4" FontSize="12"
                            AutomationProperties.Name="{DynamicResource Batch.SelectNoneName}"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3" Height="210"
                    Background="{DynamicResource InsetSurfaceBrush}"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" Padding="8">
                <ListBox x:Name="AccountsList" Background="Transparent"
                         BorderThickness="0"
                         AutomationProperties.Name="{DynamicResource Batch.SelectedAccountsName}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Padding="10" Cursor="Hand"
                                      AutomationProperties.Name="{Binding AutomationName}"
                                      AutomationProperties.HelpText="{Binding AutomationHelpText}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="8" Height="46" CornerRadius="4"
                                            Background="{Binding ColorHex}"
                                            VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Identity}"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding DestinationSummary}"
                                                   ToolTip="{Binding DestinationToolTip}"
                                                   Foreground="{DynamicResource InfoTextBrush}"
                                                   FontSize="11"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Border Grid.Column="2" Padding="8,4" Margin="12,0,0,0"
                                            CornerRadius="7"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding GroupVisibility}">
                                        <TextBlock Text="{Binding GroupName}"
                                                   Foreground="{DynamicResource ControlTextBrush}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="4" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Batch.Delay}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Batch.DelayDetail}"
                               Foreground="{DynamicResource MutedBrush}" FontSize="11"
                               Margin="0,4,12,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox x:Name="DelayComboBox" Grid.Column="1"
                          Height="40" VerticalContentAlignment="Center"
                          AutomationProperties.Name="{DynamicResource Batch.DelayName}"
                          AutomationProperties.HelpText="{DynamicResource Batch.DelayHelp}">
                    <ComboBoxItem Content="{DynamicResource Batch.Delay3}" Tag="3"/>
                    <ComboBoxItem Content="{DynamicResource Batch.Delay5}" Tag="5"/>
                    <ComboBoxItem Content="{DynamicResource Batch.Delay8}" Tag="8"/>
                    <ComboBoxItem Content="{DynamicResource Batch.Delay10}" Tag="10"/>
                    <ComboBoxItem Content="{DynamicResource Batch.Delay15}" Tag="15"/>
                    <ComboBoxItem Content="{DynamicResource Batch.Delay20}" Tag="20"/>
                    <ComboBoxItem Content="{DynamicResource Batch.Delay30}" Tag="30"/>
                </ComboBox>
            </Grid>

            <Grid Grid.Row="5" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ValidationText"
                           Foreground="{DynamicResource ErrorTextBrush}" FontSize="12"
                           TextWrapping="Wrap" MinHeight="18"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Common.Cancel}" Click="CancelButton_Click" IsCancel="True"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            Padding="16,9" Margin="0,0,8,0"/>
                    <Button x:Name="StartButton" Content="{DynamicResource Batch.Start}"
                            Click="StartButton_Click" IsDefault="True"
                            Padding="22,9" AutomationProperties.Name="{DynamicResource Batch.StartName}"/>
                </StackPanel>
            </Grid>
        </Grid>
        </ScrollViewer>
    </Border>
</Window>
