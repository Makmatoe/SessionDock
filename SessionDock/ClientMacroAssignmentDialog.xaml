<Window x:Class="SessionDock.ClientMacroAssignmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Macro.AssignTitle}"
        Width="600" Height="520" MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed">
    <Border Style="{StaticResource DialogShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Macro.AssignHeading}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="22" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Macro.AssignDescription}"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,18,0,0">
                <TextBlock Text="{DynamicResource Macro.AssignMacroLabel}"
                           Foreground="{DynamicResource SubtleBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
                <ComboBox x:Name="MacroComboBox"
                          Margin="0,6,0,0" MinHeight="40"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="MacroComboBox_SelectionChanged"
                          AutomationProperties.Name="{DynamicResource Macro.AssignMacroLabel}"
                          AutomationProperties.HelpText="{DynamicResource Macro.AssignDescription}"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="0,16,0,0" Padding="10"
                    Background="{DynamicResource WorkspaceSurfaceBrush}"
                    BorderBrush="{DynamicResource WorkspaceBorderBrush}"
                    BorderThickness="1" CornerRadius="10">
                <Grid>
                    <TextBlock x:Name="EmptyClientsText"
                               Text="{DynamicResource Macro.AssignNoClients}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" TextWrapping="Wrap"/>
                    <ListBox x:Name="AssignmentsList"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="{DynamicResource Macro.AssignClientList}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="11,9"
                                        Background="{DynamicResource InsetSurfaceBrush}"
                                        BorderBrush="{DynamicResource InsetBorderBrush}"
                                        BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AssignmentLabel}"
                                                       Margin="0,3,0,0"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource Macro.AssignRemove}"
                                                Tag="{Binding AccountKey}"
                                                Click="RemoveAssignmentButton_Click"
                                                IsEnabled="{Binding HasAssignment}"
                                                Margin="12,0,0,0" Padding="10,6"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="{DynamicResource Macro.AssignWaiting}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
                <Button Grid.Column="1"
                        Content="{DynamicResource Common.Close}"
                        IsCancel="True" Padding="16,8" Margin="14,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
