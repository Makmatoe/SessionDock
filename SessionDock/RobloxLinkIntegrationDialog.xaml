<Window x:Class="SessionDock.RobloxLinkIntegrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open with SessionDock" Width="650" Height="590"
        MinWidth="500" MinHeight="460"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource DialogShell}">
                <StackPanel>
                    <TextBlock Text="Open with SessionDock"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="An optional per-user Windows handler for Roblox links. SessionDock always shows a preview and account chooser; receiving a link never launches Roblox by itself."
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="13" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,22,0,0" Padding="16"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock x:Name="StateTitleText"
                                       Text="Checking Windows registration..."
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="16" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <TextBlock x:Name="StateDescriptionText"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="12" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="16"
                            Background="{DynamicResource InfoSurfaceBrush}"
                            BorderBrush="{DynamicResource InfoTextBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="What enabling changes"
                                       Foreground="{DynamicResource InfoTextBrush}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="SessionDock adds only keys for this Windows user under HKCU\\Software\\Classes: its owned URL handler, its private sessiondock-roblox: protocol, and an Open With hint for roblox: links. It does not replace Roblox's default handler, register for all web links, elevate, or send data online."
                                       Foreground="{DynamicResource InfoTextBrush}"
                                       FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="16"
                            Background="{DynamicResource PrivacySurfaceBrush}"
                            CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="Safety at launch"
                                       Foreground="{DynamicResource PrivacyIconBrush}"
                                       FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Only official roblox.com HTTPS links and restricted roblox: links are accepted. Authentication tickets, cookies, tokens, JobIds, unknown parameters, and non-Roblox links are refused. Private-server codes are hidden in the preview and are not saved to account defaults or history."
                                       Foreground="{DynamicResource PrivacyIconBrush}"
                                       FontSize="11" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ActionStatusText" MinHeight="18"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,14,0,0"
                               TextWrapping="Wrap"
                               AutomationProperties.LiveSetting="Polite"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <WrapPanel>
                            <Button x:Name="EnableButton" Content="Enable for this user"
                                    Click="EnableButton_Click" Padding="16,10"
                                    Margin="0,0,8,8"
                                    AutomationProperties.Name="Enable Open with SessionDock for this Windows user"
                                    AutomationProperties.HelpText="Shows a confirmation before writing the per-user Windows registration"/>
                            <Button x:Name="DisableButton" Content="Disable"
                                    Click="DisableButton_Click" Padding="16,10"
                                    Margin="0,0,8,8"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    AutomationProperties.Name="Disable Open with SessionDock"/>
                            <Button Content="Refresh" Click="RefreshButton_Click"
                                    Padding="16,10" Margin="0,0,8,8"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    AutomationProperties.Name="Refresh Windows link-handler status"/>
                        </WrapPanel>
                        <Button Grid.Column="1" Content="Close" IsCancel="True"
                                Click="CloseButton_Click" Padding="20,10"
                                VerticalAlignment="Top"
                                Background="{DynamicResource ControlSurfaceBrush}"
                                Foreground="{DynamicResource ControlTextBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
