<Window x:Class="SessionDock.SessionAutomationSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AutomationSettings.Title}"
        Width="660" Height="650" MinWidth="560" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True" ShowInTaskbar="False">
    <Border Style="{StaticResource DialogShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="DialogHeadingText"
                           Text="{DynamicResource AutomationSettings.Heading}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="22" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock x:Name="DialogIntroText"
                           Text="{DynamicResource AutomationSettings.Intro}"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,18,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,8,0">
                    <Border x:Name="WindowLayoutSection"
                            Padding="15"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="9">
                        <StackPanel>
                            <CheckBox x:Name="AutoArrangeCheckBox"
                                      VerticalContentAlignment="Center"
                                      Content="{DynamicResource AutomationSettings.AutoArrange}"
                                      AutomationProperties.HelpText="{DynamicResource AutomationSettings.AutoArrangeHelp}"/>

                            <Separator Margin="0,14,0,13"/>

                            <TextBlock Text="{DynamicResource AutomationSettings.SizeHeading}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       AutomationProperties.HeadingLevel="Level2"/>
                            <TextBlock Text="{DynamicResource AutomationSettings.SizeHelp}"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11" LineHeight="17"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,13,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="TargetWidthLabel"
                                               Text="{DynamicResource AutomationSettings.TargetWidth}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Border Height="40" Margin="0,6,0,0"
                                            Style="{StaticResource TextFieldShell}">
                                        <TextBox x:Name="TargetWidthBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 TextChanged="DimensionBox_TextChanged"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=TargetWidthLabel}"
                                                 AutomationProperties.HelpText="{DynamicResource AutomationSettings.PixelsHelp}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock x:Name="TargetHeightLabel"
                                               Text="{DynamicResource AutomationSettings.TargetHeight}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Border Height="40" Margin="0,6,0,0"
                                            Style="{StaticResource TextFieldShell}">
                                        <TextBox x:Name="TargetHeightBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 TextChanged="DimensionBox_TextChanged"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=TargetHeightLabel}"
                                                 AutomationProperties.HelpText="{DynamicResource AutomationSettings.PixelsHelp}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <TextBlock x:Name="MinimumWidthLabel"
                                               Text="{DynamicResource AutomationSettings.MinimumWidth}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Border Height="40" Margin="0,6,0,0"
                                            Style="{StaticResource TextFieldShell}">
                                        <TextBox x:Name="MinimumWidthBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 TextChanged="DimensionBox_TextChanged"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=MinimumWidthLabel}"
                                                 AutomationProperties.HelpText="{DynamicResource AutomationSettings.PixelsHelp}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2"
                                            Margin="0,12,0,0">
                                    <TextBlock x:Name="MinimumHeightLabel"
                                               Text="{DynamicResource AutomationSettings.MinimumHeight}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Border Height="40" Margin="0,6,0,0"
                                            Style="{StaticResource TextFieldShell}">
                                        <TextBox x:Name="MinimumHeightBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 TextChanged="DimensionBox_TextChanged"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=MinimumHeightLabel}"
                                                 AutomationProperties.HelpText="{DynamicResource AutomationSettings.PixelsHelp}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock x:Name="RevealXLabel"
                                               Text="{DynamicResource AutomationSettings.RevealX}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Border Height="40" Margin="0,6,0,0"
                                            Style="{StaticResource TextFieldShell}">
                                        <TextBox x:Name="RevealXBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 TextChanged="DimensionBox_TextChanged"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=RevealXLabel}"
                                                 AutomationProperties.HelpText="{DynamicResource AutomationSettings.RevealHelp}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2"
                                            Margin="0,12,0,0">
                                    <TextBlock x:Name="RevealYLabel"
                                               Text="{DynamicResource AutomationSettings.RevealY}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <Border Height="40" Margin="0,6,0,0"
                                            Style="{StaticResource TextFieldShell}">
                                        <TextBox x:Name="RevealYBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 TextChanged="DimensionBox_TextChanged"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=RevealYLabel}"
                                                 AutomationProperties.HelpText="{DynamicResource AutomationSettings.RevealHelp}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="PreferredMonitorLabel"
                                       Margin="0,14,0,0"
                                       Text="{DynamicResource AutomationSettings.PreferredMonitor}"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                            <ComboBox x:Name="PreferredMonitorComboBox"
                                      Margin="0,6,0,0" MinHeight="40"
                                      DisplayMemberPath="DisplayName"
                                      AutomationProperties.LabeledBy="{Binding ElementName=PreferredMonitorLabel}"
                                      AutomationProperties.HelpText="{DynamicResource AutomationSettings.PreferredMonitorHelp}"/>
                        </StackPanel>
                    </Border>

                    <Grid x:Name="LibrarySectionsGrid" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="TemplatesSection"
                                Padding="14"
                                Background="{DynamicResource InsetSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource AutomationSettings.TemplatesHeading}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource AutomationSettings.TemplatesHelp}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap"/>
                                <ListBox x:Name="TemplateListBox" Grid.Row="2"
                                         Margin="0,10,0,0" MinHeight="150" MaxHeight="230"
                                         SelectionMode="Extended"
                                         SelectionChanged="TemplateListBox_SelectionChanged"
                                         Background="Transparent"
                                         BorderBrush="{DynamicResource CardBorderBrush}"
                                         AutomationProperties.Name="{DynamicResource AutomationSettings.TemplatesHeading}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EmptyTemplatesText" Grid.Row="2"
                                           Margin="4,16,4,0"
                                           Text="{DynamicResource AutomationSettings.EmptyTemplates}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <StackPanel Grid.Row="3" Margin="0,10,0,0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <Button x:Name="SaveCurrentSessionButton"
                                            Content="{DynamicResource AutomationSettings.SaveCurrentSession}"
                                            Click="SaveCurrentSessionButton_Click"
                                            Padding="13,7"
                                            Margin="0,0,8,0"
                                            AutomationProperties.Name="{DynamicResource AutomationSettings.SaveCurrentSession}"
                                            AutomationProperties.HelpText="{DynamicResource AutomationSettings.SaveCurrentSessionHelp}"/>
                                    <Button x:Name="EditTemplateButton"
                                            Content="{DynamicResource AutomationSettings.EditTemplate}"
                                            Click="EditTemplateButton_Click"
                                            IsEnabled="False" Padding="13,7"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Foreground="{DynamicResource ControlTextBrush}"
                                            AutomationProperties.HelpText="{DynamicResource AutomationSettings.EditTemplateHelp}"/>
                                    <Button x:Name="DeleteTemplatesButton"
                                            Content="{DynamicResource AutomationSettings.DeleteTemplates}"
                                            Click="DeleteTemplatesButton_Click"
                                            IsEnabled="False" Padding="13,7"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Foreground="{DynamicResource ControlTextBrush}"
                                            AutomationProperties.HelpText="{DynamicResource AutomationSettings.DeleteTemplatesHelp}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border x:Name="MacroLibrarySection"
                                Grid.Column="2" Padding="14"
                                Background="{DynamicResource InsetSurfaceBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="9">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{DynamicResource AutomationSettings.MacrosHeading}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="13" FontWeight="SemiBold"
                                           AutomationProperties.HeadingLevel="Level2"/>
                                <TextBlock Grid.Row="1"
                                           Text="{DynamicResource AutomationSettings.MacrosHelp}"
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap"/>
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock x:Name="RecordingStopHotkeyLabel"
                                               Text="{DynamicResource AutomationSettings.RecordingStopHotkey}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="RecordingStopHotkeyComboBox"
                                              Margin="0,6,0,0" MinHeight="38"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              AutomationProperties.LabeledBy="{Binding ElementName=RecordingStopHotkeyLabel}"
                                              AutomationProperties.HelpText="{DynamicResource AutomationSettings.RecordingStopHotkeyHelp}"/>
                                    <TextBlock Text="{DynamicResource AutomationSettings.RecordingStopHotkeyHelp}"
                                               Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="10" TextWrapping="Wrap"/>
                                </StackPanel>
                                 <ListBox x:Name="MacroListBox" Grid.Row="3"
                                         Margin="0,10,0,0" MinHeight="150" MaxHeight="267"
                                         SelectionMode="Single"
                                         SelectionChanged="MacroListBox_SelectionChanged"
                                         Background="Transparent"
                                         BorderBrush="{DynamicResource CardBorderBrush}"
                                         AutomationProperties.Name="{DynamicResource AutomationSettings.MacrosHeading}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Summary}"
                                                           Margin="0,2,0,0"
                                                           Foreground="{DynamicResource MutedBrush}"
                                                           FontSize="10" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                     </ListBox.ItemTemplate>
                                 </ListBox>
                                <TextBlock x:Name="EmptyMacrosText" Grid.Row="3"
                                           Margin="4,16,4,0"
                                           Text="{DynamicResource AutomationSettings.EmptyMacros}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" TextWrapping="Wrap"
                                           Visibility="Collapsed"/>
                                <StackPanel Grid.Row="4" Margin="0,10,0,0"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <Button x:Name="RecordMacroButton"
                                            Content="{DynamicResource Macro.RecordTitle}"
                                            Click="RecordMacroButton_Click"
                                            Padding="13,7" Margin="0,0,8,0"
                                            AutomationProperties.HelpText="{DynamicResource Macro.RecordDescription}"/>
                                    <Button x:Name="RenameMacroButton"
                                            Content="{DynamicResource AutomationSettings.RenameMacro}"
                                            Click="RenameMacroButton_Click"
                                            IsEnabled="False" Padding="13,7"
                                            Margin="0,0,8,0"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Foreground="{DynamicResource ControlTextBrush}"
                                            AutomationProperties.HelpText="{DynamicResource AutomationSettings.RenameMacroHelp}"/>
                                    <Button x:Name="RemoveMacroButton"
                                            Content="{DynamicResource AutomationSettings.RemoveMacro}"
                                            Click="RemoveMacroButton_Click"
                                            IsEnabled="False" Padding="13,7"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Foreground="{DynamicResource ControlTextBrush}"
                                            AutomationProperties.HelpText="{DynamicResource AutomationSettings.RemoveMacroHelp}"/>
                                </StackPanel>
                             </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Margin="0,14,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="ValidationText"
                           MinHeight="18"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite"/>
                <StackPanel Grid.Row="1" Margin="0,8,0,0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="{DynamicResource AutomationSettings.Cancel}"
                            IsCancel="True" Padding="16,9" Margin="0,0,8,0"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"/>
                    <Button x:Name="SaveButton"
                            Content="{DynamicResource AutomationSettings.Save}"
                            Click="SaveButton_Click" IsDefault="True"
                            Padding="22,9"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
