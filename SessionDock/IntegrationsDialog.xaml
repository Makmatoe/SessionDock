<Window x:Class="SessionDock.IntegrationsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Integrations.Title}" Width="620" Height="520"
        MinWidth="480" MinHeight="400"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource DialogShell}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Integrations.Heading}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Integrations.Detail}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="13" Margin="0,6,0,0"
                               TextWrapping="Wrap"/>

                    <Border Margin="0,22,0,0" Padding="16"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="{DynamicResource Integrations.OpenWithHeading}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Integrations.OpenWithDetail}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource Integrations.Manage}"
                                    Click="ManageRobloxLinksButton_Click"
                                    Padding="16,9"
                                    AutomationProperties.Name="{DynamicResource Integrations.ManageOpenWithName}"
                                    AutomationProperties.HelpText="{DynamicResource Integrations.ManageOpenWithHelp}"/>
                        </Grid>
                    </Border>

                    <Border Margin="0,12,0,0" Padding="16"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,18,0">
                                <TextBlock Text="{DynamicResource Integrations.HandleScopeHeading}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Integrations.HandleScopeDetail}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="{DynamicResource Integrations.Manage}"
                                    Click="ManageHandleScopeButton_Click"
                                    Padding="16,9"
                                    AutomationProperties.Name="{DynamicResource Integrations.ManageHandleScopeName}"/>
                        </Grid>
                    </Border>

                    <Button Content="{DynamicResource Common.Close}" IsCancel="True"
                            Click="CloseButton_Click"
                            HorizontalAlignment="Right" Margin="0,24,0,0"
                            Background="{DynamicResource ControlSurfaceBrush}"
                            Foreground="{DynamicResource ControlTextBrush}"
                            Padding="20,10"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
