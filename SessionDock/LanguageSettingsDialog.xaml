<Window x:Class="SessionDock.LanguageSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Language.Title}"
        Width="520" SizeToContent="Height"
        MinWidth="440" MinHeight="330"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True">
    <Border Style="{StaticResource DialogShell}"
            AutomationProperties.Name="{DynamicResource Language.Heading}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource Language.Heading}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Language.Detail}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12" Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,24,0,0">
                <TextBlock Text="{DynamicResource Language.DisplayLanguage}"
                           Foreground="{DynamicResource SubtleBrush}"
                           FontSize="10" FontWeight="SemiBold"/>
                <ComboBox x:Name="LanguageComboBox"
                          Margin="0,8,0,0"
                          SelectionChanged="LanguageComboBox_SelectionChanged"
                          AutomationProperties.Name="{DynamicResource Language.SelectName}"
                          AutomationProperties.HelpText="{DynamicResource Language.SelectHelp}">
                    <ComboBoxItem Content="{DynamicResource Language.System}"
                                  Tag="system"/>
                    <ComboBoxItem Content="{DynamicResource Language.English}"
                                  Tag="en-US"/>
                    <ComboBoxItem Content="{DynamicResource Language.Dutch}"
                                  Tag="nl-NL"/>
                </ComboBox>
                <TextBlock Text="{DynamicResource Language.Fallback}"
                           Foreground="{DynamicResource SubtleBrush}"
                           FontSize="11" Margin="0,9,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <TextBlock x:Name="PreviewText"
                       Grid.Row="2" Margin="0,20,0,0"
                       Padding="12,10"
                       Foreground="{DynamicResource InfoTextBrush}"
                       Background="{DynamicResource InfoSurfaceBrush}"
                       FontSize="12" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite"/>

            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,26,0,0">
                <Button Content="{DynamicResource Common.Cancel}"
                        Click="CancelButton_Click" IsCancel="True"
                        MinWidth="96" Margin="0,0,9,0"
                        Background="{DynamicResource ControlSurfaceBrush}"
                        Foreground="{DynamicResource ControlTextBrush}"/>
                <Button Content="{DynamicResource Language.Save}"
                        Click="SaveButton_Click" IsDefault="True"
                        MinWidth="132"
                        AutomationProperties.Name="{DynamicResource Language.SaveName}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
