<Window x:Class="SessionDock.SessionMacroControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Macro.ControllerTitle}"
        Width="310" MinWidth="280" MinHeight="104"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        Closing="Window_Closing">
    <Border Margin="8" Padding="10"
            Background="{DynamicResource WorkspaceSurfaceBrush}"
            BorderBrush="{DynamicResource WorkspaceBorderBrush}"
            BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="112"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton"
                    Content="{DynamicResource Macro.ControllerPlay}"
                    Click="PlayButton_Click"
                    MinHeight="44" Padding="20,10"
                    AutomationProperties.Name="{DynamicResource Macro.ControllerPlay}"
                    AutomationProperties.HelpText="{DynamicResource Macro.ControllerPlayHelp}"/>
            <ComboBox x:Name="SpeedComboBox"
                      Grid.Column="1" Margin="10,0,0,0"
                      MinHeight="44"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="SpeedComboBox_SelectionChanged"
                      AutomationProperties.Name="{DynamicResource Macro.ControllerSpeed}"
                      AutomationProperties.HelpText="{DynamicResource Macro.ControllerSpeedHelp}"/>
        </Grid>
    </Border>
</Window>
