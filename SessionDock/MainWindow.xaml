                       FontSize="24" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level2"/>
            <TextBlock Text="{DynamicResource SettingsHub.Description}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="12" Margin="0,5,10,16"
                       TextWrapping="Wrap"/>

            <UniformGrid Columns="2">
              <Border Style="{StaticResource SettingsHubTile}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource SettingsHub.AppearanceTitle}"
                             Foreground="{DynamicResource TextBrush}"
                             FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource SettingsHub.AppearanceDetail}"
