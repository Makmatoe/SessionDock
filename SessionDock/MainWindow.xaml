                             Foreground="{DynamicResource MutedBrush}"
                             FontSize="11" Margin="0,4,0,0"
                             TextWrapping="Wrap"/>
                  <Button x:Name="SettingsMacroLibraryButton"
                          Style="{StaticResource SettingsHubActionButton}"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding IsEnabled, ElementName=SessionAutomationSettingsButton}"
                          Click="MacroLibrarySettingsButton_Click"
                          Content="{DynamicResource SettingsHub.AutomationAction}"
                          AutomationProperties.Name="{DynamicResource AutomationSettings.MacrosHeading}"
                          AutomationProperties.HelpText="{DynamicResource AutomationSettings.MacrosHelp}"/>
                </StackPanel>
              </Border>

              <Border x:Name="SettingsTemplatesButtonTile"
                      Style="{StaticResource SettingsHubTile}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource AutomationSettings.TemplatesHeading}"
                             Foreground="{DynamicResource TextBrush}"
                             FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource AutomationSettings.TemplatesHelp}"
                             Foreground="{DynamicResource MutedBrush}"
                             FontSize="11" Margin="0,4,0,0"
                             TextWrapping="Wrap"/>
                  <Button x:Name="SettingsTemplatesButton"
                          Style="{StaticResource SettingsHubActionButton}"
                          HorizontalAlignment="Left"
                          IsEnabled="{Binding IsEnabled, ElementName=SessionAutomationSettingsButton}"
                          Click="TemplateSettingsButton_Click"
                          Content="{DynamicResource SettingsHub.AutomationAction}"
                          AutomationProperties.Name="{DynamicResource AutomationSettings.TemplatesHeading}"
                          AutomationProperties.HelpText="{DynamicResource AutomationSettings.TemplatesHelp}"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SettingsHubTile}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource SettingsHub.CurrentBatchTitle}"
                             Foreground="{DynamicResource TextBrush}"
                             FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource SettingsHub.CurrentBatchDetail}"
                             Foreground="{DynamicResource MutedBrush}"
                             FontSize="11" Margin="0,4,0,0"
                             TextWrapping="Wrap"/>
