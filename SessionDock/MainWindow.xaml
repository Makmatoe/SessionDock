                            Content="{DynamicResource SettingsHub.ThemeAction}"
                            AutomationProperties.HelpText="{DynamicResource Main.ThemeHelp}"/>
                    <Button x:Name="SettingsSoundButton"
                            Style="{StaticResource SettingsHubActionButton}"
                            IsEnabled="{Binding IsEnabled, ElementName=SoundSettingsButton}"
                            Click="SoundSettingsButton_Click"
                            Content="{DynamicResource Main.SoundSettings}"/>
                    <Button x:Name="SettingsLanguageButton"
                            Style="{StaticResource SettingsHubActionButton}"
                            IsEnabled="{Binding IsEnabled, ElementName=LanguageSettingsButton}"
