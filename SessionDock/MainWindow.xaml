              </Border>

              <Border Style="{StaticResource SettingsHubTile}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource SettingsHub.HelpTitle}"
                             Foreground="{DynamicResource TextBrush}"
                             FontSize="15" FontWeight="SemiBold"/>
                  <TextBlock Text="{DynamicResource SettingsHub.HelpDetail}"
