                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SignInButton"
                                            Style="{StaticResource QuietButton}"
                                            Click="SignInButton_Click"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Left"
