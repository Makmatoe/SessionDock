                  Data="{StaticResource IconBack}"/>
          </Button>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{DynamicResource Destinations.Title}"
                       Foreground="{DynamicResource TextBrush}"
                       FontSize="19" FontWeight="SemiBold"
                       AutomationProperties.HeadingLevel="Level1"/>
            <TextBlock Text="{DynamicResource Destinations.Subtitle}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,8,24,20">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Padding="12"
                  Background="{DynamicResource WorkspaceSurfaceBrush}"
                  BorderBrush="{DynamicResource WorkspaceBorderBrush}"
                  BorderThickness="1" CornerRadius="10">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="{DynamicResource Destinations.SavedHeading}"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="13" FontWeight="SemiBold"
                         AutomationProperties.HeadingLevel="Level2"/>
              <ListBox x:Name="NamedDestinationsList"
                       Grid.Row="1" Margin="0,9,0,9"
                       DisplayMemberPath="Name"
                       SelectionChanged="NamedDestinationsList_SelectionChanged"
                       AutomationProperties.Name="{DynamicResource Destinations.SavedHeading}"/>
              <TextBlock x:Name="DestinationsEmptyText"
                         Grid.Row="1" Margin="8"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Text="{DynamicResource Destinations.Empty}"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="11" TextAlignment="Center"
                         TextWrapping="Wrap"
                         IsHitTestVisible="False"
                         AutomationProperties.LiveSetting="Polite"/>
              <Button x:Name="NewDestinationButton"
                      Grid.Row="2"
                      Click="NewDestinationButton_Click"
                      Content="{DynamicResource Destinations.New}"
                      Padding="12,8"
                      AutomationProperties.HelpText="{DynamicResource Destinations.NewHelp}"/>
            </Grid>
          </Border>

          <Border Grid.Column="1" Margin="14,0,0,0" Padding="16"
                  Background="{DynamicResource WorkspaceSurfaceBrush}"
                  BorderBrush="{DynamicResource WorkspaceBorderBrush}"
                  BorderThickness="1" CornerRadius="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="DestinationEditorHeadingText"
                           Text="{DynamicResource Destinations.EditorNewHeading}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="16" FontWeight="SemiBold"
                           AutomationProperties.HeadingLevel="Level2"/>
                <TextBlock Text="{DynamicResource Destinations.EditorHelp}"
                           Margin="0,4,0,14"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{DynamicResource Destinations.Name}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <Border Height="42" Margin="0,6,0,12"
                        Style="{StaticResource TextFieldShell}">
                  <TextBox x:Name="DestinationNameBox"
                           MaxLength="80"
                           Style="{StaticResource EmbeddedTextBox}"
                           AutomationProperties.Name="{DynamicResource Destinations.Name}"/>
                </Border>
                <TextBlock Text="{DynamicResource Destinations.Value}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <Border Height="42" Margin="0,6,0,12"
                        Style="{StaticResource TextFieldShell}">
                  <TextBox x:Name="DestinationValueBox"
                           MaxLength="4096"
                           Style="{StaticResource EmbeddedTextBox}"
                           AutomationProperties.Name="{DynamicResource Destinations.Value}"
                           AutomationProperties.HelpText="{DynamicResource Main.DestinationHelp}"/>
                </Border>
                <TextBlock Text="{DynamicResource Destinations.AssignHeading}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="{DynamicResource Destinations.AssignHelp}"
                           Margin="0,4,0,7"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" TextWrapping="Wrap"/>
                <ListBox x:Name="DestinationAccountAssignmentsList"
                         MaxHeight="190" Padding="0"
                         BorderThickness="0" Background="Transparent"
                         IsTabStop="False"
                         AutomationProperties.Name="{DynamicResource Destinations.AssignHeading}">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,0,0,4"/>
                      <Setter Property="Focusable" Value="False"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding DisplayName}"
                                IsChecked="{Binding IsAssigned, Mode=TwoWay}"
                                ToolTip="{Binding DestinationSummary}"
                                AutomationProperties.HelpText="{Binding DestinationSummary}"/>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="DestinationEditorValidationText"
                           MinHeight="18" Margin="0,8,0,0"
                           Foreground="{DynamicResource ErrorTextBrush}"
                           FontSize="11" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive"/>
                <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                  <Button x:Name="DeleteDestinationButton"
                          Margin="0,0,8,0" Padding="12,8"
                          Click="DeleteDestinationButton_Click"
                          Content="{DynamicResource Destinations.Delete}"
                          Background="{DynamicResource ErrorSurfaceBrush}"
                          Foreground="{DynamicResource ErrorMutedTextBrush}"/>
                  <Button x:Name="SaveDestinationButton"
                          Padding="16,8"
                          Click="SaveDestinationButton_Click"
                          Content="{DynamicResource Destinations.Save}"/>
                </WrapPanel>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <Grid x:Name="DestinationUnsavedOverlay"
              Grid.RowSpan="2" Visibility="Collapsed"
              Panel.ZIndex="20"
              Background="{DynamicResource TutorialOverlayBrush}"
              KeyboardNavigation.TabNavigation="Cycle">
          <Border MaxWidth="440" Margin="24" Padding="20"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource FocusBrush}"
                  BorderThickness="2" CornerRadius="14">
            <StackPanel>
              <TextBlock Text="{DynamicResource Destinations.UnsavedTitle}"
                         Foreground="{DynamicResource TextBrush}"
                         FontSize="19" FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         AutomationProperties.HeadingLevel="Level2"/>
              <TextBlock Text="{DynamicResource Destinations.UnsavedBody}"
                         Margin="0,7,0,0"
                         Foreground="{DynamicResource MutedBrush}"
                         FontSize="12" TextWrapping="Wrap"/>
              <WrapPanel Margin="0,18,0,0"
                         HorizontalAlignment="Right">
                <Button x:Name="DestinationUnsavedCancelButton"
                        Margin="0,0,8,0" Padding="12,8"
                        Click="DestinationUnsavedCancelButton_Click"
                        Content="{DynamicResource Common.Cancel}"/>
                <Button x:Name="DestinationUnsavedDiscardButton"
                        Margin="0,0,8,0" Padding="12,8"
                        Click="DestinationUnsavedDiscardButton_Click"
                        Content="{DynamicResource Destinations.Discard}"
                        Background="{DynamicResource ErrorSurfaceBrush}"
                        Foreground="{DynamicResource ErrorMutedTextBrush}"/>
                <Button x:Name="DestinationUnsavedSaveButton"
                        Padding="16,8" IsDefault="True"
                        Click="DestinationUnsavedSaveButton_Click"
                        Content="{DynamicResource Common.Save}"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="AccountsWorkspace"
