<Window x:Class="SessionDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SessionDock"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SessionDock" Width="1080" Height="720"
        MinWidth="800" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="False"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="MainWindow_SizeChanged"
        TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SubtleBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="RailIconButton" TargetType="Button"
               BasedOn="{StaticResource IconOnlyButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource RailButtonSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RailButtonTextBrush}"/>
        </Style>

        <Style x:Key="RailThemeToggle" TargetType="ToggleButton"
               BasedOn="{StaticResource IconOnlyToggleButton}">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Background" Value="{DynamicResource RailButtonSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource RailButtonTextBrush}"/>
        </Style>

        <Style x:Key="QuietButton" TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlTextBrush}"/>
        </Style>

        <Style x:Key="SegmentRadioButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource ControlSurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background"
                                        Value="{DynamicResource SelectedControlSurfaceBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SelectedControlTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource FocusBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Opacity" Value=".75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SegmentBorder"
                                        Property="Opacity" Value=".35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SegmentRadioIcon" TargetType="Path"
               BasedOn="{StaticResource ButtonIcon}">
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="64"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Slim utility rail. Account management lives in the strip above the workspace. -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="12,12,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Width="40" Height="40" CornerRadius="10"
                        ClipToBounds="True"
                        ToolTip="{DynamicResource Main.AppTooltip}">
                    <Image Width="52" Height="52" Margin="-6"
                           Source="/SessionDock;component/Assets/SessionDock.Icon.png"
                           Stretch="Uniform"/>
                </Border>

                <StackPanel Grid.Row="2">
                    <ToggleButton x:Name="ThemeToggleButton"
                                  Style="{StaticResource RailThemeToggle}"
                                  IsChecked="True"
                                  Click="ThemeToggleButton_Click"
                                  Margin="0,0,0,6"
                                  AutomationProperties.Name="{DynamicResource Main.ThemeDarkToLight}"
                                  AutomationProperties.HelpText="{DynamicResource Main.ThemeHelp}"
                                  ToolTip="{DynamicResource Main.ThemeDarkToLight}">
                        <Path x:Name="ThemeToggleIcon"
                              Style="{StaticResource ButtonIcon}"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                              Data="{StaticResource IconMoon}"/>
                    </ToggleButton>
                    <Button x:Name="SoundSettingsButton"
                            Style="{StaticResource RailIconButton}"
                            Click="SoundSettingsButton_Click"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="{DynamicResource Main.SoundSettings}"
                            ToolTip="{DynamicResource Main.SoundSettings}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconSound}"/>
                    </Button>
                    <Button x:Name="LanguageSettingsButton"
                            Style="{StaticResource RailIconButton}"
                            Click="LanguageSettingsButton_Click"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="{DynamicResource Main.LanguageSettings}"
                            AutomationProperties.HelpText="{DynamicResource Main.LanguageSettingsHelp}"
                            ToolTip="{DynamicResource Main.LanguageSettings}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconLanguage}"/>
                    </Button>
                    <Button x:Name="MetadataTransferButton"
                            Style="{StaticResource RailIconButton}"
                            Click="MetadataTransferButton_Click"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="{DynamicResource Main.MetadataTransfer}"
                            AutomationProperties.HelpText="{DynamicResource Main.MetadataTransferHelp}"
                            ToolTip="{DynamicResource Main.MetadataTransferTooltip}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconTransfer}"/>
                    </Button>
                    <Button x:Name="IntegrationsButton"
                            Style="{StaticResource RailIconButton}"
                            Click="IntegrationsButton_Click"
                            Margin="0,0,0,6"
                            AutomationProperties.Name="{DynamicResource Main.ManageIntegrations}"
                            ToolTip="{DynamicResource Main.ManageIntegrations}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconIntegration}"/>
                    </Button>
                    <Button x:Name="RunningClientsButton"
                            Style="{StaticResource RailIconButton}"
                            Click="RunningClientsButton_Click"
                            Margin="0,0,0,10"
                            AutomationProperties.Name="{DynamicResource Main.ManageClients}"
                            AutomationProperties.HelpText="{DynamicResource Main.ManageClientsHelp}"
                            ToolTip="{DynamicResource Main.ViewClients}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconClients}"/>
                    </Button>
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="4,0,4,10"/>
                    <Border Width="40" Height="32" CornerRadius="8"
                            Background="{DynamicResource PrivacySurfaceBrush}"
                            ToolTip="{DynamicResource Main.PrivacyTooltip}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconLock}"
                              Width="14" Height="14" Stroke="{DynamicResource PrivacyIconBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main launch workspace. -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="HeaderRow" Height="64"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="HeaderGrid" Margin="20,10,20,7">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="HeaderTextPanel"
                            VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Main.Heading}"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Main.Subtitle}"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="HeaderUtilityPanel"
                            Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="AboutDiagnosticsButton"
                            Style="{StaticResource IconOnlyButton}"
                            Width="34" Height="34" Padding="8"
                            Margin="0,0,6,0"
                            Background="{DynamicResource UtilitySurfaceBrush}" Foreground="{DynamicResource UtilityTextBrush}"
                            Click="AboutDiagnosticsButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource Main.AboutName}"
                            AutomationProperties.HelpText="{DynamicResource Main.AboutHelp}"
                            ToolTip="{DynamicResource Main.AboutTooltip}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconActivity}"/>
                    </Button>
                    <Button x:Name="ReleaseNotesButton"
                            Style="{StaticResource IconOnlyButton}"
                            Width="34" Height="34" Padding="8"
                            Margin="0,0,6,0"
                            Background="{DynamicResource UtilitySurfaceBrush}" Foreground="{DynamicResource UtilityTextBrush}"
                            Click="ReleaseNotesButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource Main.ReleaseNotesName}"
                            AutomationProperties.HelpText="{DynamicResource Main.ReleaseNotesHelp}"
                            ToolTip="{DynamicResource Main.ReleaseNotesTooltip}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconReleaseNotes}"/>
                    </Button>
                    <Button x:Name="InstallUpdateButton"
                            Style="{StaticResource IconOnlyButton}"
                            Width="34" Height="34" Padding="8"
                            Margin="0,0,8,0"
                            Background="{DynamicResource UtilitySurfaceBrush}" Foreground="{DynamicResource UtilityTextBrush}"
                            Click="InstallUpdateButton_Click"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="{DynamicResource Main.UpdateName}"
                            ToolTip="{DynamicResource Main.UpdateTooltip}">
                        <Path Style="{StaticResource ButtonIcon}"
                              Data="{StaticResource IconUpdate}"/>
                    </Button>
                    <Border Background="{DynamicResource BadgeSurfaceBrush}" CornerRadius="8"
                            BorderBrush="{DynamicResource BadgeBorderBrush}" BorderThickness="1"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="6" Height="6" CornerRadius="3"
                                    Background="{DynamicResource SuccessTextBrush}" Margin="0,0,7,0"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Main.Local}" Foreground="{DynamicResource BadgeTextBrush}"
                                       FontSize="11" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Width="1" Height="24" Margin="12,0,8,0"
                            Background="{DynamicResource StrokeBrush}"/>
                    <local:WindowCaptionControls x:Name="CaptionControls"/>
                </StackPanel>
            </Grid>

            <!-- The account selector remains visible in both Launch and Recent. -->
            <Border Grid.Row="1" Padding="20,5"
                    Background="{DynamicResource AccountStripSurfaceBrush}" BorderBrush="{DynamicResource AccountStripBorderBrush}"
                    BorderThickness="0,1,0,1" MinHeight="64">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Width="72" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Main.Account}" Style="{StaticResource SectionLabel}"/>
                        <TextBlock x:Name="AccountStripHintText"
                                   Text="{DynamicResource Main.DragToReorder}"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <Grid x:Name="AccountsViewport" Grid.Column="1"
                          Margin="8,0,12,0" ClipToBounds="True">
                        <ScrollViewer x:Name="AccountsScrollViewer"
                                      VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly"
                                      AllowDrop="True"
                                      PreviewMouseWheel="AccountsScrollViewer_PreviewMouseWheel"
                                      PreviewDragOver="AccountsScrollViewer_PreviewDragOver"
                                      PreviewDrop="AccountsScrollViewer_PreviewDrop"
                                      DragLeave="AccountsScrollViewer_DragLeave"
                                      AutomationProperties.Name="{DynamicResource Main.SavedAccounts}">
                            <StackPanel x:Name="AccountsList"
                                        Orientation="Horizontal"/>
                        </ScrollViewer>
                        <Border x:Name="AccountDropIndicator"
                                Panel.ZIndex="1"
                                Width="3" Margin="0,6,0,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource AccentBrush}"
                                CornerRadius="2"
                                IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <Border Grid.Column="2" Width="154" Height="34"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextFieldShell}">
                        <Grid>
                            <TextBox x:Name="AccountSearchBox"
                                     Style="{StaticResource EmbeddedTextBox}"
                                     Padding="10,0,34,0"
                                     VerticalContentAlignment="Center"
                                     MaxLength="256"
                                     TextChanged="AccountSearchBox_TextChanged"
                                     ToolTip="{DynamicResource Main.AccountSearchTooltip}"
                                     AutomationProperties.Name="{DynamicResource Main.AccountSearchName}"
                                     AutomationProperties.LiveSetting="Polite"
                                     AutomationProperties.HelpText="{DynamicResource Main.AccountSearchHelp}"/>
                            <TextBlock Text="{DynamicResource Main.AccountSearchPlaceholder}"
                                       Margin="10,0,34,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       FontSize="11"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AccountSearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button x:Name="AccountSearchClearButton"
                                    Panel.ZIndex="1"
                                    Click="AccountSearchClearButton_Click"
                                    ToolTip="{DynamicResource Main.ClearAccountSearchTooltip}"
                                    AutomationProperties.Name="{DynamicResource Main.ClearAccountSearchName}"
                                    AutomationProperties.HelpText="{DynamicResource Main.ClearAccountSearchTooltip}">
                                <Button.Style>
                                    <Style TargetType="Button"
                                           BasedOn="{StaticResource SearchClearButton}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Setter Property="IsTabStop" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=AccountSearchBox}"
                                                         Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="IsTabStop" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Style="{StaticResource ButtonIcon}"
                                      Data="{StaticResource IconClear}"/>
                            </Button>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button x:Name="AddAccountButton"
                                Style="{StaticResource IconOnlyButton}"
                                Width="40" Height="40" Padding="10"
                                Background="{DynamicResource ControlSurfaceBrush}" Foreground="{DynamicResource InfoTextBrush}"
                                Click="AddAccountButton_Click"
                            AutomationProperties.Name="{DynamicResource Main.AddAccount}"
                            ToolTip="{DynamicResource Main.AddAccountTooltip}">
                            <Path Style="{StaticResource ButtonIcon}"
                                  Data="{StaticResource IconAdd}"/>
                        </Button>
                        <Button x:Name="EditAccountButton"
                                Style="{StaticResource IconOnlyButton}"
                                Width="40" Height="40" Padding="10"
                                Margin="6,0,0,0"
                                Background="{DynamicResource ControlSurfaceBrush}" Foreground="{DynamicResource ControlTextBrush}"
                                Click="EditAccountButton_Click"
                            AutomationProperties.Name="{DynamicResource Main.EditAccount}"
                            ToolTip="{DynamicResource Main.EditAccountTooltip}">
                            <Path Style="{StaticResource ButtonIcon}"
                                  Data="{StaticResource IconEdit}"/>
                        </Button>
                        <Button x:Name="ResetButton"
                                Style="{StaticResource IconOnlyButton}"
                                Width="40" Height="40" Padding="10"
                                Margin="6,0,0,0"
                                Background="{DynamicResource ErrorSurfaceBrush}" Foreground="{DynamicResource ErrorMutedTextBrush}"
                                Click="ResetButton_Click"
                            AutomationProperties.Name="{DynamicResource Main.RemoveAccount}"
                            ToolTip="{DynamicResource Main.RemoveAccountTooltip}">
                            <Path Style="{StaticResource ButtonIcon}"
                                  Data="{StaticResource IconTrash}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="20,10,20,8">
                <Border x:Name="LauncherPanel"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12"
                        Padding="18,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid x:Name="LaunchHeaderGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"
                                        KeyboardNavigation.TabNavigation="Once">
                                <RadioButton x:Name="LaunchTabButton"
                                        GroupName="MainWorkspaceTabs"
                                        IsChecked="True"
                                        Style="{StaticResource SegmentRadioButton}"
                                        Margin="0,0,6,0"
                            AutomationProperties.Name="{DynamicResource Main.Launch}"
                            ToolTip="{DynamicResource Main.LaunchTabTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SegmentRadioIcon}"
                                              Data="{StaticResource IconLaunch}"
                                              Width="14" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Main.Launch}"/>
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="RecentTabButton"
                                        GroupName="MainWorkspaceTabs"
                                        IsChecked="False"
                                        Style="{StaticResource SegmentRadioButton}"
                            AutomationProperties.Name="{DynamicResource Main.Recent}"
                            ToolTip="{DynamicResource Main.RecentTabTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource SegmentRadioIcon}"
                                              Data="{StaticResource IconHistory}"
                                              Width="14" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Main.Recent}"/>
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                            <TextBlock x:Name="DestinationSavedText"
                                       Grid.Column="2"
                                       Text="{DynamicResource Main.DestinationSaved}"
                                       Foreground="{DynamicResource SubtleBrush}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextWrapping="Wrap"/>
                        </Grid>

                        <ScrollViewer x:Name="LaunchTabPanel" Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      PanningMode="VerticalOnly">
                            <Grid Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel>
                            <TextBlock Text="{DynamicResource Main.Destination}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DestinationHelpText"
                                       Text="{DynamicResource Main.DestinationHelp}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                                KeyboardNavigation.DirectionalNavigation="Cycle"
                                                KeyboardNavigation.TabNavigation="Once">
                                        <RadioButton x:Name="ExperienceDestinationModeButton"
                                          GroupName="DestinationMode"
                                          IsChecked="True"
                                          Content="{DynamicResource Main.Experience}"
                                                Style="{StaticResource SegmentRadioButton}"
                                                Padding="10,7" Margin="0,0,4,0"
                                          AutomationProperties.Name="{DynamicResource Main.JoinExperience}"/>
                                        <RadioButton x:Name="UserDestinationModeButton"
                                          GroupName="DestinationMode"
                                          IsChecked="False"
                                          Content="{DynamicResource Main.User}"
                                                Style="{StaticResource SegmentRadioButton}"
                                                Padding="10,7"
                                          AutomationProperties.Name="{DynamicResource Main.JoinUser}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="46"
                                                Style="{StaticResource TextFieldShell}">
                                            <TextBox x:Name="PlaceIdBox"
                                                     Style="{StaticResource EmbeddedTextBox}"
                                                     TextWrapping="NoWrap"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                     TextChanged="PlaceIdBox_TextChanged"
                                                     LostKeyboardFocus="PlaceIdBox_LostKeyboardFocus"
                                                     KeyDown="PlaceIdBox_KeyDown"
                                         ToolTip="{DynamicResource Main.DestinationInputTooltip}"
                                         AutomationProperties.Name="{DynamicResource Main.DestinationInputName}"/>
                                        </Border>
                                        <Button x:Name="SetDestinationForAllButton"
                                                Grid.Column="1" Height="46" MinWidth="116"
                                                Margin="8,0,0,0" Padding="13,9"
                                                Style="{StaticResource QuietButton}"
                                                IsEnabled="False"
                                                Click="SetDestinationForAllButton_Click"
                                    ToolTip="{DynamicResource Main.SetForAllTooltip}"
                                    AutomationProperties.Name="{DynamicResource Main.SetForAllName}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ButtonIcon}"
                                                      Data="{StaticResource IconBatch}"
                                                      Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Main.SetForAll}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="DestinationValidationText"
                                               Visibility="Collapsed"
                                               Foreground="{DynamicResource ErrorMutedTextBrush}" FontSize="11"
                                               Margin="3,7,3,0" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <Border x:Name="AutoJoinUserPanel"
                                            Visibility="Collapsed"
                                            Margin="0,9,0,0" Padding="11,9"
                                            Background="{DynamicResource InsetSurfaceBrush}"
                                            BorderBrush="{DynamicResource InsetBorderBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <StackPanel>
                                            <CheckBox x:Name="AutoJoinUserCheckBox"
                                                      IsChecked="False"
                                                      Content="{DynamicResource Main.AutoJoinLabel}"
                                                      Checked="AutoJoinUserCheckBox_Changed"
                                                      Unchecked="AutoJoinUserCheckBox_Changed"
                                                      ToolTip="{DynamicResource Main.AutoJoinHelp}"
                                                      AutomationProperties.Name="{DynamicResource Main.AutoJoinName}"
                                                      AutomationProperties.HelpText="{DynamicResource Main.AutoJoinHelp}"/>
                                            <TextBlock x:Name="AutoJoinWatchDetailText"
                                                       Text="{DynamicResource Main.AutoJoinHelp}"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       FontSize="11" Margin="25,4,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="ServerJobIdWarningPanel"
                                            Visibility="Collapsed"
                                            Margin="0,8,0,0" Padding="11,9"
                                            Background="{DynamicResource WarningSurfaceBrush}" BorderBrush="{DynamicResource WarningBorderBrush}"
                                            BorderThickness="1" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="21"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource IconWarning}"
                                                  Width="15" Height="15"
                                                  Stretch="Uniform" Fill="Transparent"
                                                  Stroke="{DynamicResource WarningTextBrush}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  VerticalAlignment="Top"/>
                                            <TextBlock Grid.Column="1"
                                           Text="{DynamicResource Main.TrackedJobWarning}"
                                                       Foreground="{DynamicResource WarningMutedTextBrush}" FontSize="11"
                                                       TextWrapping="Wrap"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <Border Grid.Row="2" Margin="0,16,0,16"
                                        Background="{DynamicResource InsetSurfaceBrush}" CornerRadius="8"
                                        BorderBrush="{DynamicResource InsetBorderBrush}" BorderThickness="1"
                                        Padding="13,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="26" Height="26" CornerRadius="7"
                                                Background="{DynamicResource AccentSurfaceBrush}"
                                                VerticalAlignment="Center">
                                            <Path Style="{StaticResource ButtonIcon}"
                                                  Data="{StaticResource IconAccount}"
                                                  Stroke="{DynamicResource InfoTextBrush}" Width="14" Height="14"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="9,0,0,0"
                                                    VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Main.LaunchingSelected}"
                                                       Foreground="{DynamicResource ControlTextBrush}" FontSize="12"
                                                       FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource Main.PerAccountHistory}"
                                                       Foreground="{DynamicResource SubtleBrush}"
                                                       FontSize="11" Margin="0,2,0,0"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Grid x:Name="LaunchActionsGrid" Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="SignInButton"
                                            Style="{StaticResource QuietButton}"
                                            Click="SignInButton_Click"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Left"
                                    AutomationProperties.Name="{DynamicResource Main.SignInName}"
                                    ToolTip="{DynamicResource Main.SignInTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ButtonIcon}"
                                                  Data="{StaticResource IconBrowser}"
                                                  Width="15" Height="15" Margin="0,0,7,0"/>
                                <TextBlock x:Name="SignInButtonLabel" Text="{DynamicResource Main.SignIn}"/>
                                        </StackPanel>
                                    </Button>
                                    <StackPanel x:Name="LaunchPrimaryActionsPanel"
                                                Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="BatchLaunchButton"
                                                Style="{StaticResource QuietButton}"
                                                Click="BatchLaunchButton_Click"
                                                MinWidth="118" IsEnabled="False"
                                                Margin="0,0,8,0"
                                    AutomationProperties.Name="{DynamicResource Main.BatchLaunch}"
                                    ToolTip="{DynamicResource Main.BatchTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ButtonIcon}"
                                                      Data="{StaticResource IconBatch}"
                                                      Width="15" Height="15" Margin="0,0,7,0"/>
                                <TextBlock Text="{DynamicResource Main.Batch}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="LaunchButton"
                                                Click="LaunchButton_Click"
                                                MinWidth="170" IsEnabled="False"
                                    AutomationProperties.Name="{DynamicResource Main.LaunchRoblox}"
                                    ToolTip="{DynamicResource Main.LaunchTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ButtonIcon}"
                                                      Data="{StaticResource IconLaunch}"
                                                      Width="15" Height="15" Margin="0,0,7,0"/>
                                <TextBlock x:Name="LaunchButtonLabel" Text="{DynamicResource Main.Launch}"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <Grid x:Name="RecentTabPanel" Grid.Row="1"
                              Visibility="Collapsed" Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Main.RecentExperiences}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Main.RecentSubtitle}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            KeyboardNavigation.TabNavigation="Once">
                                    <RadioButton x:Name="AllTypeFilterButton"
                                            GroupName="RecentTypeFilter"
                                            IsChecked="True"
                                            Content="{DynamicResource Common.All}"
                                            Style="{StaticResource SegmentRadioButton}"
                                            Padding="10,7" Margin="0,0,4,0"/>
                                    <RadioButton x:Name="PublicFilterButton"
                                            GroupName="RecentTypeFilter"
                                            IsChecked="False"
                                            Content="{DynamicResource Main.Public}"
                                            Style="{StaticResource SegmentRadioButton}"
                                            Padding="10,7" Margin="0,0,4,0"/>
                                    <RadioButton x:Name="PrivateFilterButton"
                                            GroupName="RecentTypeFilter"
                                            IsChecked="False"
                                            Content="{DynamicResource Main.Private}"
                                            Style="{StaticResource SegmentRadioButton}"
                                            Padding="10,7"/>
                                </StackPanel>
                                <Border Grid.Column="1" Height="34"
                                        MinWidth="120" MaxWidth="280"
                                        Margin="12,0"
                                        Style="{StaticResource TextFieldShell}">
                                    <Grid>
                                        <TextBox x:Name="RecentSearchBox"
                                                 Style="{StaticResource EmbeddedTextBox}"
                                                 Padding="10,0,34,0"
                                                 VerticalContentAlignment="Center"
                                                 MaxLength="256"
                                                 TextChanged="RecentSearchBox_TextChanged"
                                                 ToolTip="{DynamicResource Main.RecentSearchTooltip}"
                                                 AutomationProperties.Name="{DynamicResource Main.RecentSearchName}"
                                                 AutomationProperties.LiveSetting="Polite"
                                                 AutomationProperties.HelpText="{DynamicResource Main.RecentSearchHelp}"/>
                                        <TextBlock Text="{DynamicResource Main.RecentSearchPlaceholder}"
                                                   Margin="10,0,34,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   FontSize="11"
                                                   IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=RecentSearchBox}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button x:Name="RecentSearchClearButton"
                                                Panel.ZIndex="1"
                                                Click="RecentSearchClearButton_Click"
                                                ToolTip="{DynamicResource Main.ClearRecentSearchTooltip}"
                                                AutomationProperties.Name="{DynamicResource Main.ClearRecentSearchName}"
                                                AutomationProperties.HelpText="{DynamicResource Main.ClearRecentSearchTooltip}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource SearchClearButton}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Setter Property="IsTabStop" Value="True"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=RecentSearchBox}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Setter Property="IsTabStop" Value="False"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <Path Style="{StaticResource ButtonIcon}"
                                                  Data="{StaticResource IconClear}"/>
                                        </Button>
                                    </Grid>
                                </Border>
                                <ComboBox x:Name="AccountFilterCombo" Grid.Column="2"
                                          Width="168" Height="34"
                                          SelectionChanged="AccountFilterCombo_SelectionChanged"
                                          Padding="8,4"
                                          AutomationProperties.Name="{DynamicResource Main.RecentAccountFilter}"/>
                                <Button x:Name="ClearHistoryButton" Grid.Column="3"
                                        Style="{StaticResource IconOnlyButton}"
                                        Width="32" Height="32" Padding="7"
                                        Margin="8,0,0,0"
                                        Click="ClearHistoryButton_Click"
                                        Background="Transparent" Foreground="{DynamicResource MutedBrush}"
                                        AutomationProperties.Name="{DynamicResource Main.ClearHistory}"
                                        ToolTip="{DynamicResource Main.ClearHistoryTooltip}">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconTrash}"/>
                                </Button>
                            </Grid>
                            <ScrollViewer x:Name="RecentExperiencesScrollViewer"
                                          Grid.Row="2" Margin="0,6,0,4"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          PanningMode="VerticalOnly"
                                          AutomationProperties.Name="{DynamicResource Main.RecentList}">
                                <StackPanel x:Name="RecentExperiencesList"/>
                            </ScrollViewer>
                            <Grid Grid.Row="3">
                                <TextBlock x:Name="RecentPrivacyText"
                                           Text="{DynamicResource Main.SharedLocal}"
                                           Foreground="{DynamicResource SubtleBrush}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="BrowserPanel" Visibility="Collapsed"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource StrokeBrush}"
                        BorderThickness="1" CornerRadius="12"
                        ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="54"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Background="{DynamicResource WorkspaceSurfaceBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="16,0,12,0"
                                        VerticalAlignment="Center">
                                <Border Width="7" Height="7" CornerRadius="4"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="0,0,9,0"/>
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Main.OfficialSignIn}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{DynamicResource Main.PasteHint}"
                                               Foreground="{DynamicResource SubtleBrush}"
                                               FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Style="{StaticResource QuietButton}"
                                    Margin="0,9,10,9" Padding="13,7"
                                    AutomationProperties.Name="{DynamicResource Main.BackName}"
                                    ToolTip="{DynamicResource Main.BackTooltip}"
                                    Click="BrowserBackButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconBack}"
                                          Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Main.Back}"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid x:Name="BrowserHost" Grid.Row="1"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Compact activity strip. -->
            <Border Grid.Row="3" Margin="20,0,20,0" Padding="12,7"
                    Background="{DynamicResource WorkspaceSurfaceBrush}" CornerRadius="10"
                    BorderBrush="{DynamicResource WorkspaceBorderBrush}" BorderThickness="1" MinHeight="56">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="StatusIconBorder" Width="30" Height="30"
                            CornerRadius="8" Background="{DynamicResource InfoSurfaceBrush}"
                            VerticalAlignment="Center">
                        <Path x:Name="StatusIconGlyph" Width="15" Height="15"
                              Data="{StaticResource IconActivity}"
                               Stroke="{DynamicResource InfoTextBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round" Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,14,0"
                                VerticalAlignment="Center">
                        <TextBlock x:Name="StatusTitle"
                                   Text="{DynamicResource Main.CheckingSession}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <TextBlock x:Name="StatusDetail"
                                   Text="{DynamicResource Main.CheckingSessionDetail}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" Margin="0,2,0,0"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border x:Name="SessionBadgeBorder"
                                Background="{DynamicResource SuccessSurfaceBrush}" CornerRadius="7"
                                Padding="9,5" HorizontalAlignment="Right">
                            <TextBlock x:Name="SessionBadge" Text="{DynamicResource Main.CheckingSessionBadge}"
                                       Foreground="{DynamicResource SuccessTextBrush}" FontSize="11"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <Button x:Name="RetryFailedBatchButton"
                                Visibility="Collapsed" IsEnabled="False"
                                Click="RetryFailedBatchButton_Click"
                                Content="{DynamicResource Main.RetryFailed}" Margin="0,5,0,0"
                                Padding="8,5" FontSize="11"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                Foreground="{DynamicResource WarningTextBrush}"
                                AutomationProperties.Name="{DynamicResource Main.RetryFailedName}"
                                AutomationProperties.HelpText="{DynamicResource Main.RetryFailedHelp}"/>
                        <Button x:Name="CancelBatchButton"
                                Visibility="Collapsed" IsEnabled="False"
                                Click="CancelBatchButton_Click"
                                Content="{DynamicResource Main.CancelBatch}" Margin="0,5,0,0"
                                Padding="8,5" FontSize="11"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource ErrorSurfaceBrush}" Foreground="{DynamicResource ErrorMutedTextBrush}"
                                AutomationProperties.Name="{DynamicResource Main.CancelBatchName}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="RequirementsFooterGrid"
                  Grid.Row="4" Margin="20,5,20,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RequirementsText"
                           Text="{DynamicResource Main.Requirements}"
                           Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="NotAffiliatedText" Grid.Column="1"
                           Text="{DynamicResource Main.NotAffiliated}"
                           Foreground="{DynamicResource SubtleBrush}" FontSize="11"
                           Margin="14,0,0,0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
