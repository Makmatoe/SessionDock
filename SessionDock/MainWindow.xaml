                          Content="{DynamicResource Main.ManageIntegrations}"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SettingsHubTile}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource SettingsHub.DataPrivacyTitle}"
                             Foreground="{DynamicResource TextBrush}"
                             FontSize="15" FontWeight="SemiBold"/>
