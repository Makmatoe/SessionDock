                            Style="{StaticResource SettingsHubActionButton}"
                            IsEnabled="False"
                            Click="OpenMacroControllerButton_Click"
                            Content="{DynamicResource SettingsHub.MacroControllerAction}"/>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource SettingsHubTile}">
                <StackPanel>
                  <TextBlock Text="{DynamicResource SettingsHub.IntegrationsTitle}"
