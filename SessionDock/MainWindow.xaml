          <RowDefinition Height="64"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="18,10,12,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="126"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="DestinationsBackButton"
                  Style="{StaticResource IconOnlyButton}"
                  Width="38" Height="38" Padding="9"
                  Margin="0,0,11,0"
                  Background="{DynamicResource UtilitySurfaceBrush}"
                  Foreground="{DynamicResource UtilityTextBrush}"
                  Click="SetupBackButton_Click"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"
                  AutomationProperties.Name="{DynamicResource Home.BackToHome}"
                  ToolTip="{DynamicResource Home.BackToHome}">
