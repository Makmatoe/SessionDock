                    <Button x:Name="SettingsBatchAssignmentsButton"
                            Style="{StaticResource SettingsHubActionButton}"
                            IsEnabled="False"
                            Click="CurrentBatchAssignmentsButton_Click"
                            Content="{DynamicResource SettingsHub.BatchAssignmentsAction}"/>
