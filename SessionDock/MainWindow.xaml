                          Content="{DynamicResource SettingsHub.AutomationAction}"
                          AutomationProperties.Name="{DynamicResource AutomationSettings.SizeHeading}"
                          AutomationProperties.HelpText="{DynamicResource AutomationSettings.SizeHelp}"/>
