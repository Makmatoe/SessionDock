                             FontSize="11" Margin="0,4,0,0"
                             TextWrapping="Wrap"/>
                  <WrapPanel>
                    <Button x:Name="SettingsThemeButton"
                            Style="{StaticResource SettingsHubActionButton}"
                            IsEnabled="{Binding IsEnabled, ElementName=ThemeToggleButton}"
