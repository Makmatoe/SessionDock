      </Grid>

      <!-- Home and the compact settings hub share one caption-control owner.
           Advanced keeps its existing integrated header and caption controls. -->
      <local:WindowCaptionControls x:Name="HomeCaptionControls"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   Margin="0,10,12,0"
                                   Panel.ZIndex="4"/>

      <local:GuidedTourOverlay x:Name="HomeGuidedTour"
                               Panel.ZIndex="10"/>
    </Grid>
</Window>
