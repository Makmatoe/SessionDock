<Window x:Class="SessionDock.HandleScopeIntegrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Handle.Title}" Width="720" Height="680"
        MinWidth="480" MinHeight="460"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource DialogShell}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                VerticalAlignment="Top">
                            <Path Data="{StaticResource IconIntegration}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource InfoTextBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{DynamicResource Handle.Heading}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="{DynamicResource Handle.Detail}"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="13"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,24,0,0" Padding="18"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StateIconShell" Width="34" Height="34"
                                    CornerRadius="8"
                                    Background="{DynamicResource BadgeSurfaceBrush}"
                                    VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Path x:Name="StateIcon" Data="{StaticResource IconActivity}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource BadgeTextBrush}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,16,0">
                        <TextBlock x:Name="StateTitleText" Text="{DynamicResource Handle.CheckingSetup}"
                                           Foreground="{DynamicResource TextBrush}" FontSize="16"
                                           FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock x:Name="StateDescriptionText"
                                   Text="{DynamicResource Handle.CheckingDetail}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                           Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="StateBadge"
                                    Background="{DynamicResource BadgeSurfaceBrush}"
                                    CornerRadius="8"
                                    Padding="9,5" VerticalAlignment="Top">
                        <TextBlock x:Name="StateBadgeText" Text="{DynamicResource Common.Checking}"
                                           Foreground="{DynamicResource BadgeTextBrush}"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="RepairWarningPanel" Grid.Row="2"
                            Visibility="Collapsed" Margin="0,12,0,0" Padding="15"
                            Background="{DynamicResource WarningSurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconWarning}" Width="18" Height="18"
                                  Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource WarningTextBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                            <TextBlock Text="{DynamicResource Handle.Attention}"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="RepairWarningText"
                                       Text="{DynamicResource Handle.AttentionDetail}"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontSize="11"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,22,0,0">
                <TextBlock Text="{DynamicResource Handle.Controls}"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="{DynamicResource Handle.SecurityDetail}"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="12"
                                   Margin="0,7,0,0" TextWrapping="Wrap"/>

                        <WrapPanel Margin="0,15,0,0">
                            <Button x:Name="InstallLatestHandleScopeButton"
                                    Click="InstallLatestHandleScopeButton_Click"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    Padding="14,10" Margin="0,0,8,8"
                            ToolTip="{DynamicResource Handle.InstallTooltip}"
                            AutomationProperties.Name="{DynamicResource Handle.InstallName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconUpdate}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Handle.Install}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RefreshButton" Click="RefreshButton_Click"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    Padding="14,10" Margin="0,0,8,8"
                            AutomationProperties.Name="{DynamicResource Handle.RefreshName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconRefresh}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Common.Refresh}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="StartApiButton" Click="StartApiButton_Click"
                                    Padding="14,10" Margin="0,0,8,8"
                            AutomationProperties.Name="{DynamicResource Handle.StartName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconLaunch}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Handle.Start}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="EnableButton" Click="EnableButton_Click"
                                    Padding="14,10" Margin="0,0,8,8"
                            AutomationProperties.Name="{DynamicResource Handle.EnableName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconCheck}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Handle.Enable}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="DisableButton" Click="DisableButton_Click"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    Padding="14,10" Margin="0,0,8,8"
                            AutomationProperties.Name="{DynamicResource Handle.DisableName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconLock}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Handle.Disable}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="TestConnectionButton"
                                    Click="TestConnectionButton_Click"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    Padding="14,10" Margin="0,0,8,8"
                            AutomationProperties.Name="{DynamicResource Handle.TestName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconActivity}" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource Handle.Test}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RepairButton" Click="RepairButton_Click"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource WarningSurfaceBrush}"
                                    Foreground="{DynamicResource WarningTextBrush}"
                                    Padding="14,10"
                                    Margin="0,0,8,8"
                            AutomationProperties.Name="{DynamicResource Handle.RepairName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconWarning}" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="RepairButtonLabel"
                                   Text="{DynamicResource Handle.Repair}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock x:Name="ActionStatusText" MinHeight="18"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   Margin="0,3,0,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,23,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                <TextBlock Text="{DynamicResource Handle.TestDetail}"
                                   Foreground="{DynamicResource SubtleBrush}" FontSize="10"
                                   Margin="0,0,18,0" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
            <Button Grid.Column="1" Content="{DynamicResource Common.Close}" Click="CloseButton_Click"
                                IsCancel="True"
                                Background="{DynamicResource ControlSurfaceBrush}"
                                Foreground="{DynamicResource ControlTextBrush}"
                                Padding="20,10"/>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
