<Window x:Class="SessionDock.HandleScopeIntegrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Handle.Title}" Width="720" Height="720"
        MinWidth="500" MinHeight="500"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" ShowInTaskbar="False">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Border Style="{StaticResource DialogShell}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="10"
                                Background="{DynamicResource InfoSurfaceBrush}"
                                VerticalAlignment="Top">
                            <Path Data="{StaticResource IconIntegration}"
                                  Width="22" Height="22" Stretch="Uniform"
                                  Fill="Transparent"
                                  Stroke="{DynamicResource InfoTextBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="{DynamicResource Handle.Heading}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource Handle.Detail}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="13" Margin="0,6,0,0"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Margin="0,24,0,0" Padding="18"
                            Background="{DynamicResource InsetSurfaceBrush}"
                            CornerRadius="10"
                            BorderBrush="{DynamicResource StrokeBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StateIconShell" Width="34" Height="34"
                                    CornerRadius="8"
                                    Background="{DynamicResource BadgeSurfaceBrush}"
                                    VerticalAlignment="Top" HorizontalAlignment="Left">
                                <Path x:Name="StateIcon" Data="{StaticResource IconActivity}"
                                      Width="17" Height="17" Stretch="Uniform"
                                      Fill="Transparent"
                                      Stroke="{DynamicResource BadgeTextBrush}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,16,0">
                                <TextBlock x:Name="StateTitleText"
                                           Text="{DynamicResource Handle.CheckingSetup}"
                                           Foreground="{DynamicResource TextBrush}"
                                           FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <TextBlock x:Name="StateDescriptionText"
                                           Text="{DynamicResource Handle.CheckingDetail}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="12" Margin="0,5,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="2" x:Name="StateBadge"
                                    Background="{DynamicResource BadgeSurfaceBrush}"
                                    CornerRadius="8" Padding="9,5"
                                    VerticalAlignment="Top">
                                <TextBlock x:Name="StateBadgeText"
                                           Text="{DynamicResource Common.Checking}"
                                           Foreground="{DynamicResource BadgeTextBrush}"
                                           FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border x:Name="AttentionPanel" Grid.Row="2"
                            Visibility="Collapsed" Margin="0,12,0,0" Padding="15"
                            Background="{DynamicResource WarningSurfaceBrush}"
                            BorderBrush="{DynamicResource WarningBorderBrush}"
                            BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Data="{StaticResource IconWarning}" Width="18" Height="18"
                                  Stretch="Uniform" Fill="Transparent"
                                  Stroke="{DynamicResource WarningTextBrush}"
                                  StrokeThickness="1.8" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource Handle.Attention}"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AttentionDetailText"
                                           Text="{DynamicResource Handle.AttentionDetail}"
                                           Foreground="{DynamicResource WarningTextBrush}"
                                           FontSize="11" Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,20,0,0">
                        <TextBlock Text="{DynamicResource Handle.Controls}"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" FontWeight="Bold"/>
                        <TextBlock Text="{DynamicResource Handle.SecurityDetail}"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="12" Margin="0,7,0,0"
                                   TextWrapping="Wrap"/>
                        <CheckBox x:Name="IntegrationEnabledCheckBox"
                                  Content="{DynamicResource Handle.EnableSwitch}"
                                  Checked="IntegrationEnabledCheckBox_Checked"
                                  Unchecked="IntegrationEnabledCheckBox_Unchecked"
                                  Padding="2,8" Margin="0,10,0,0"
                                  FontWeight="SemiBold"
                                  AutomationProperties.Name="{DynamicResource Handle.EnableName}"
                                  AutomationProperties.HelpText="{DynamicResource Handle.EnableHelp}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RestartButton"
                                    Click="RestartButton_Click"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource ControlSurfaceBrush}"
                                    Foreground="{DynamicResource ControlTextBrush}"
                                    Padding="14,10" Margin="0,0,8,8"
                                    AutomationProperties.Name="{DynamicResource Handle.RestartName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconRefresh}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Handle.Restart}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RetryButton"
                                    Click="RetryButton_Click"
                                    Visibility="Collapsed"
                                    Padding="14,10" Margin="0,0,8,8"
                                    AutomationProperties.Name="{DynamicResource Handle.RetryName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconRefresh}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Handle.Retry}"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="RepairButton"
                                    Click="RepairButton_Click"
                                    Visibility="Collapsed"
                                    Background="{DynamicResource WarningSurfaceBrush}"
                                    Foreground="{DynamicResource WarningTextBrush}"
                                    Padding="14,10" Margin="0,0,8,8"
                                    AutomationProperties.Name="{DynamicResource Handle.RepairName}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ButtonIcon}"
                                          Data="{StaticResource IconWarning}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Handle.Repair}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="ActionStatusText" MinHeight="18"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="11" Margin="0,3,0,0"
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>

                    <Expander x:Name="AdvancedOptionsExpander"
                              Grid.Row="4" Margin="0,16,0,0"
                              Foreground="{DynamicResource TextBrush}"
                              AutomationProperties.Name="{DynamicResource Handle.AdvancedHeading}">
                        <Expander.Header>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Handle.AdvancedHeading}"
                                           FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Handle.AdvancedDetail}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Expander.Header>
                        <Border Margin="0,10,0,0" Padding="16"
                                Background="{DynamicResource InsetSurfaceBrush}"
                                CornerRadius="10"
                                BorderBrush="{DynamicResource StrokeBrush}"
                                BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Handle.RuntimeSourceLabel}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="RuntimeSourceComboBox"
                                                  Margin="0,6,0,0" MinWidth="210"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="RuntimeSourceComboBox_SelectionChanged"
                                                  AutomationProperties.Name="{DynamicResource Handle.RuntimeSourceName}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Handle.ApiVersionLabel}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="ApiContractComboBox"
                                                  Margin="0,6,0,0" MinWidth="180"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectionChanged="ApiContractComboBox_SelectionChanged"
                                                  AutomationProperties.Name="{DynamicResource Handle.ApiVersionName}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="RuntimeSourceDescriptionText"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="11" Margin="0,9,0,0"
                                           TextWrapping="Wrap"/>
                                <StackPanel Margin="0,14,0,0">
                                    <TextBlock Text="{DynamicResource Handle.RuntimeVersionLabel}"
                                               Foreground="{DynamicResource TextBrush}"
                                               FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox x:Name="StandaloneRuntimeVersionComboBox"
                                              Margin="0,6,0,0" MinWidth="260"
                                              HorizontalAlignment="Left"
                                              DisplayMemberPath="DisplayName"
                                              SelectionChanged="StandaloneRuntimeVersionComboBox_SelectionChanged"
                                              AutomationProperties.Name="{DynamicResource Handle.RuntimeVersionName}"/>
                                    <TextBlock Text="{DynamicResource Handle.RuntimeVersionDetail}"
                                               Foreground="{DynamicResource MutedBrush}"
                                               FontSize="11" Margin="0,7,0,0"
                                               TextWrapping="Wrap"/>
                                    <Button x:Name="RefreshReviewedVersionsButton"
                                            Click="RefreshReviewedVersionsButton_Click"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Foreground="{DynamicResource ControlTextBrush}"
                                            Padding="12,8" Margin="0,10,0,0"
                                            AutomationProperties.Name="{DynamicResource Handle.RefreshVersionsName}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ButtonIcon}"
                                                  Data="{StaticResource IconRefresh}"
                                                  Margin="0,0,7,0"/>
                                            <TextBlock Text="{DynamicResource Handle.RefreshVersions}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Handle.BundledVersionLabel}"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   FontSize="11" FontWeight="Bold"/>
                                        <Border Margin="0,5,0,0" Padding="10,7"
                                                Background="{DynamicResource FieldBackgroundBrush}"
                                                BorderBrush="{DynamicResource FieldBorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <TextBlock x:Name="BundledVersionText"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       AutomationProperties.Name="{DynamicResource Handle.BundledVersionLabel}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{DynamicResource Handle.StandaloneVersionLabel}"
                                                   Foreground="{DynamicResource SubtleBrush}"
                                                   FontSize="11" FontWeight="Bold"/>
                                        <Border Margin="0,5,0,0" Padding="10,7"
                                                Background="{DynamicResource FieldBackgroundBrush}"
                                                BorderBrush="{DynamicResource FieldBorderBrush}"
                                                BorderThickness="1" CornerRadius="6">
                                            <TextBlock x:Name="StandaloneVersionText"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       AutomationProperties.Name="{DynamicResource Handle.StandaloneVersionLabel}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Expander>

                    <Grid Grid.Row="5" Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{DynamicResource Handle.FooterDetail}"
                                   Foreground="{DynamicResource SubtleBrush}"
                                   FontSize="11" Margin="0,0,18,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button Grid.Column="1" Content="{DynamicResource Common.Close}"
                                Click="CloseButton_Click" IsCancel="True"
                                Background="{DynamicResource ControlSurfaceBrush}"
                                Foreground="{DynamicResource ControlTextBrush}"
                                Padding="20,10"/>
                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
