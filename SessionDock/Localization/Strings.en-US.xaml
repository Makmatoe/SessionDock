    <sys:String x:Key="Home.Subtitle">Setup, launch, and automate</sys:String>
    <sys:String x:Key="Home.Heading">Build and run your session</sys:String>
    <sys:String x:Key="Home.Description">Set up accounts and destinations, launch a batch or template, then manage layouts and macros.</sys:String>
    <sys:String x:Key="Home.Settings">Settings</sys:String>
    <sys:String x:Key="Home.SettingsHelp">Open focused SessionDock settings and advanced workspace access.</sys:String>
    <sys:String x:Key="Home.BackToHome">Back to home</sys:String>
    <sys:String x:Key="Home.LaunchAccounts">Launch accounts</sys:String>
    <sys:String x:Key="Home.LaunchAccountsHelp">Choose accounts for a batch launch and arrange their Roblox windows in a clickable cascade.</sys:String>
    <sys:String x:Key="Home.LaunchAccountsShort">Choose a batch and build the cascade</sys:String>
    <sys:String x:Key="Home.RunTemplate">Run template</sys:String>
    <sys:String x:Key="Home.RunTemplateHelp">Launch saved accounts, restore their windows, and load assigned macros. Select Play to loop them continuously until Stop.</sys:String>
    <sys:String x:Key="Home.RunTemplateShort">Restore a saved complete session</sys:String>
    <sys:String x:Key="Home.RecordMacro">Macros</sys:String>
    <sys:String x:Key="Home.RecordMacroHelp">Record, review, edit, and delete individual-client or whole-session ExactWheel macros.</sys:String>
    <sys:String x:Key="Home.RecordMacroShort">Record and manage your macro library</sys:String>
    <sys:String x:Key="Home.SaveTemplate">Templates</sys:String>
    <sys:String x:Key="Home.SaveTemplateHelp">Create, edit, delete, and run saved account, destination, layout, and macro configurations.</sys:String>
    <sys:String x:Key="Home.SaveTemplateShort">Build and manage reusable sessions</sys:String>
    <sys:String x:Key="Home.Ready">Ready. Macro files stay local and never loop until you explicitly select Play.</sys:String>
    <sys:String x:Key="Home.StopAutomationHelp">Stop the active account launch, window layout, or macro loop at the next safe point.</sys:String>
