    <sys:String x:Key="Template.NoTemplatesTitle">Noch keine Vorlagen</sys:String>
    <sys:String x:Key="Template.NoTemplatesDescription">Speichere zuerst die aktuelle Sitzung als Vorlage oder erstelle unter Einstellungen eine Stapelvorgabe.</sys:String>
    <sys:String x:Key="Template.LegacyPreset">Stapelvorgabe</sys:String>
