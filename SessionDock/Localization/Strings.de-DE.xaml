    <sys:String x:Key="Handle.StateDisabledDescription">Eine unterstützte HandleScope-Installation ist vorhanden. SessionDock hat die API nicht kontaktiert; aktivieren Sie die Integration vor dem Test.</sys:String>
    <sys:String x:Key="Handle.StateDisabledTitle">Integration deaktiviert</sys:String>
    <sys:String x:Key="Handle.StateNotInstalledBadge">NICHT INSTALLIERT</sys:String>
