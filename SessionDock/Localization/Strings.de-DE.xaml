    <sys:String x:Key="Handle.StateReadyTitle">Bereit für SessionDock</sys:String>
    <sys:String x:Key="Handle.StateStoppedBadge">NICHT VERBUNDEN</sys:String>
    <sys:String x:Key="Handle.StateStoppedDescription">Die exakt unterstützte Version v0.1.3 der HandleScope-API ist installiert. Starten Sie sie separat mit dem offiziell mitinstallierten Skript oder dem optionalen Autostart und testen Sie dann die Verbindung.</sys:String>
    <sys:String x:Key="Handle.StateStoppedTitle">Installiert – Verbindung nicht getestet</sys:String>
    <sys:String x:Key="Handle.StateUnavailableBadge">NICHT VERFÜGBAR</sys:String>
