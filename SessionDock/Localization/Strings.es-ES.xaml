    <sys:String x:Key="LinkIntegration.EnableHelp">Muestra una confirmación antes de escribir el registro de Windows para este usuario</sys:String>
    <sys:String x:Key="LinkIntegration.Disable">Desactivar</sys:String>
    <sys:String x:Key="LinkIntegration.DisableName">Desactivar Abrir con SessionDock</sys:String>
    <sys:String x:Key="LinkIntegration.RefreshName">Actualizar el estado del controlador de enlaces de Windows</sys:String>
    <sys:String x:Key="LinkIntegration.EnableConfirmTitle">Activar Abrir con SessionDock</sys:String>
    <sys:String x:Key="LinkIntegration.EnableConfirm">¿Activar Abrir con SessionDock para este usuario de Windows?&#10;&#10;Windows recibirá un pequeño registro por usuario en HKCU\Software\Classes. No se sustituirá el controlador predeterminado de Roblox. Cada enlace aceptado seguirá requiriendo elegir una cuenta y confirmar el inicio por separado.</sys:String>
    <sys:String x:Key="LinkIntegration.DisableConfirmTitle">Desactivar Abrir con SessionDock</sys:String>
