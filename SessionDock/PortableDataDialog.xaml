<Window x:Class="SessionDock.PortableDataDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Portable.Title}"
        Width="820" Height="720" MinWidth="620" MinHeight="560"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI Variable Text"
        UseLayoutRounding="True" ShowInTaskbar="False"
        AutomationProperties.Name="{DynamicResource Portable.AutomationName}">
    <Window.Resources>
        <Style x:Key="PortableTabItem" TargetType="{x:Type TabItem}">
            <Setter Property="Background"
                    Value="{DynamicResource ControlSurfaceBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource ControlTextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="FocusVisualStyle"
                    Value="{StaticResource KeyboardFocusVisual}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8,8,0,0">
                            <ContentPresenter ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Panel.ZIndex" Value="1"/>
                                <Setter Property="Background"
                                        Value="{DynamicResource SelectedControlSurfaceBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SelectedControlTextBrush}"/>
                                <Setter Property="BorderBrush"
                                        Value="{DynamicResource FieldHoverBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface"
                                        Property="Opacity" Value=".9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface"
                                        Property="Opacity" Value=".45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortableTabControl"
               TargetType="{x:Type TabControl}">
            <Setter Property="Background"
                    Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource PortableTabItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Grid ClipToBounds="True"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1"
                                      Panel.ZIndex="1"/>
                            <Border Grid.Row="1" Margin="0,-1,0,0"
                                    Padding="1"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="0,0,9,9">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  Content="{TemplateBinding SelectedContent}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding SelectedContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PortableCategoryBorder" TargetType="Border">
            <Setter Property="Margin" Value="0,0,0,9"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Background"
                    Value="{DynamicResource InsetSurfaceBrush}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
        </Style>

        <Style x:Key="PortableExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <DataTemplate x:Key="PortableSelectionItemTemplate">
            <Border Margin="0,4,0,0" Padding="9,7"
                    Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="7">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                          IsEnabled="{Binding IsSelectable}"
                          VerticalContentAlignment="Top"
                          AutomationProperties.Name="{Binding AutomationName}"
                          AutomationProperties.HelpText="{Binding Detail}">
                    <StackPanel Margin="5,0,0,0">
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}"
                                   Margin="0,2,0,0"
                                   Foreground="{DynamicResource MutedBrush}"
                                   FontSize="10" LineHeight="15"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </CheckBox>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border Style="{StaticResource DialogShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="{DynamicResource Portable.Heading}"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="23" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           AutomationProperties.HeadingLevel="Level1"/>
                <TextBlock Margin="0,5,0,0"
                           Text="{DynamicResource Portable.Detail}"
                           Foreground="{DynamicResource MutedBrush}"
                           FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Border Grid.Row="1" Margin="0,14,0,12" Padding="12,10"
                    Background="{DynamicResource InfoSurfaceBrush}"
                    BorderBrush="{DynamicResource InfoBorderBrush}"
                    BorderThickness="1" CornerRadius="9">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Portable.PrivacyHeading}"
                               Foreground="{DynamicResource InfoTextBrush}"
                               FontSize="12" FontWeight="SemiBold"
                               TextWrapping="Wrap"/>
                    <TextBlock Margin="0,4,0,0"
                               Text="{DynamicResource Portable.PrivacyDetail}"
                               Foreground="{DynamicResource InfoTextBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <TabControl x:Name="ActionTabControl" Grid.Row="2"
                        Style="{StaticResource PortableTabControl}"
                        AutomationProperties.Name="{DynamicResource Portable.ActionName}">
                <TabItem Header="{DynamicResource Portable.ExportTab}"
                         AutomationProperties.Name="{DynamicResource Portable.ExportTab}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="{DynamicResource Portable.ExportChooseHeading}">
                            <StackPanel Margin="0,0,8,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Portable.ExportChooseHeading}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.HeadingLevel="Level2"/>
                                        <TextBlock x:Name="ExportSelectedCountText"
                                                   Margin="0,3,10,0"
                                                   Text="{DynamicResource Portable.ExportNoneSelected}"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1"
                                               HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Portable.SelectEligible}"
                                                Margin="0,0,7,0" Padding="10,6"
                                                Background="{DynamicResource ControlSurfaceBrush}"
                                                Foreground="{DynamicResource ControlTextBrush}"
                                                Click="SelectEligibleButton_Click"
                                                AutomationProperties.HelpText="{DynamicResource Portable.SelectEligibleHelp}"/>
                                        <Button Content="{DynamicResource Portable.Clear}" Padding="10,6"
                                                Background="{DynamicResource ControlSurfaceBrush}"
                                                Foreground="{DynamicResource ControlTextBrush}"
                                                Click="ClearSelectionButton_Click"/>
                                    </WrapPanel>
                                </Grid>

                                <Border Style="{StaticResource PortableCategoryBorder}">
                                    <Expander Style="{StaticResource PortableExpander}"
                                              IsExpanded="True">
                                        <Expander.Header>
                                            <TextBlock x:Name="TemplatesCategoryHeader"
                                                       Text="{DynamicResource Portable.Templates}"
                                                       FontWeight="SemiBold"/>
                                        </Expander.Header>
                                        <ItemsControl x:Name="TemplateItemsControl"
                                                      Margin="0,4,0,0"
                                                      ItemTemplate="{StaticResource PortableSelectionItemTemplate}"/>
                                    </Expander>
                                </Border>

                                <Border Style="{StaticResource PortableCategoryBorder}">
                                    <Expander Style="{StaticResource PortableExpander}"
                                              IsExpanded="True">
                                        <Expander.Header>
                                            <TextBlock x:Name="MacrosCategoryHeader"
                                                       Text="{DynamicResource Portable.Macros}"
                                                       FontWeight="SemiBold"/>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock Margin="0,5,0,2"
                                                       Text="{DynamicResource Portable.MacroKeyboardAutoSelectWarning}"
                                                       Foreground="{DynamicResource WarningMutedTextBrush}"
                                                       FontSize="10" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="MacroItemsControl"
                                                          ItemTemplate="{StaticResource PortableSelectionItemTemplate}"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <Border Style="{StaticResource PortableCategoryBorder}">
                                    <Expander Style="{StaticResource PortableExpander}">
                                        <Expander.Header>
                                            <TextBlock x:Name="DestinationsCategoryHeader"
                                                       Text="{DynamicResource Portable.PublicDestinations}"
                                                       FontWeight="SemiBold"/>
                                        </Expander.Header>
                                        <StackPanel>
                                            <TextBlock x:Name="DestinationEligibilityText"
                                                       Margin="0,5,0,2"
                                                       Foreground="{DynamicResource MutedBrush}"
                                                       FontSize="10" TextWrapping="Wrap"/>
                                            <ItemsControl x:Name="DestinationItemsControl"
                                                          ItemTemplate="{StaticResource PortableSelectionItemTemplate}"/>
                                        </StackPanel>
                                    </Expander>
                                </Border>

                                <Border Style="{StaticResource PortableCategoryBorder}">
                                    <Expander Style="{StaticResource PortableExpander}">
                                        <Expander.Header>
                                            <TextBlock x:Name="PresetsCategoryHeader"
                                                       Text="{DynamicResource Portable.LaunchPresets}"
                                                       FontWeight="SemiBold"/>
                                        </Expander.Header>
                                        <ItemsControl x:Name="PresetItemsControl"
                                                      Margin="0,4,0,0"
                                                      ItemTemplate="{StaticResource PortableSelectionItemTemplate}"/>
                                    </Expander>
                                </Border>

                                <CheckBox x:Name="ExportKeyboardAcknowledgementCheckBox"
                                          Margin="2,2,2,10"
                                          Visibility="Collapsed"
                                          Checked="ExportAcknowledgementCheckBox_Changed"
                                          Unchecked="ExportAcknowledgementCheckBox_Changed"
                                          Content="{DynamicResource Portable.ExportKeyboardConfirmation}"
                                          AutomationProperties.Name="{DynamicResource Portable.ExportKeyboardConfirmationName}"/>

                                <Border Padding="11,9" Margin="0,0,0,9"
                                        Background="{DynamicResource WarningSurfaceBrush}"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Portable.PrivacySummaryHeading}"
                                                   Foreground="{DynamicResource WarningStrongTextBrush}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ExportPrivacySummaryText"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource WarningMutedTextBrush}"
                                                   FontSize="10" LineHeight="15"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ExportReviewPanel"
                                        Visibility="Collapsed"
                                        Padding="11,9" Margin="0,0,0,4"
                                        Background="{DynamicResource SuccessSurfaceBrush}"
                                        BorderBrush="{DynamicResource SuccessBorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Portable.ExportReadyHeading}"
                                                   Foreground="{DynamicResource SuccessTextBrush}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   AutomationProperties.HeadingLevel="Level2"/>
                                        <TextBlock x:Name="ExportReviewSummaryText"
                                                   Margin="0,4,0,0"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="10" LineHeight="15"
                                                   TextWrapping="Wrap"/>
                                        <CheckBox x:Name="ShowManifestCheckBox"
                                                  Margin="0,8,0,0"
                                                  Content="{DynamicResource Portable.ShowManifest}"
                                                  Checked="ShowManifestCheckBox_Changed"
                                                  Unchecked="ShowManifestCheckBox_Changed"/>
                                        <Border x:Name="ManifestPreviewBorder"
                                                Visibility="Collapsed"
                                                Margin="0,7,0,0" Padding="8"
                                                Background="{DynamicResource InsetSurfaceBrush}"
                                                BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="7">
                                            <TextBox x:Name="ManifestPreviewBox"
                                                     Height="160"
                                                     IsReadOnly="True"
                                                     IsReadOnlyCaretVisible="True"
                                                     AcceptsReturn="True"
                                                     TextWrapping="NoWrap"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource TextBrush}"
                                                     FontFamily="Consolas" FontSize="10"
                                                     AutomationProperties.Name="{DynamicResource Portable.ManifestName}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ExportStatusText"
                                       Text="{DynamicResource Portable.ExportInitialStatus}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right">
                                <Button x:Name="ReviewExportButton"
                                        Content="{DynamicResource Portable.ReviewSelection}"
                                        IsEnabled="False" Padding="12,8"
                                        Margin="0,0,8,0"
                                        Background="{DynamicResource ControlSurfaceBrush}"
                                        Foreground="{DynamicResource ControlTextBrush}"
                                        Click="ReviewExportButton_Click"
                                        AutomationProperties.HelpText="{DynamicResource Portable.ReviewSelectionHelp}"/>
                                <Button x:Name="ExportPackageButton"
                                        Content="{DynamicResource Portable.ExportButton}"
                                        IsEnabled="False" Padding="14,8"
                                        Click="ExportPackageButton_Click"
                                        AutomationProperties.Name="{DynamicResource Portable.ExportButtonName}"/>
                            </WrapPanel>
                        </Grid>
                    </Grid>
                </TabItem>

                <TabItem Header="{DynamicResource Portable.ImportTab}"
                         AutomationProperties.Name="{DynamicResource Portable.ImportTab}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      AutomationProperties.Name="{DynamicResource Portable.ImportChooseHeading}">
                            <StackPanel Margin="0,0,8,0">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Portable.ImportChooseHeading}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.HeadingLevel="Level2"/>
                                        <TextBlock Text="{DynamicResource Portable.ImportChooseDetail}"
                                                   Margin="0,3,10,0"
                                                   Foreground="{DynamicResource MutedBrush}"
                                                   FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button x:Name="ChooseImportPackageButton"
                                            Grid.Column="1"
                                            Content="{DynamicResource Portable.ChoosePackage}"
                                            Padding="12,8"
                                            Background="{DynamicResource ControlSurfaceBrush}"
                                            Foreground="{DynamicResource ControlTextBrush}"
                                            Click="ChooseImportPackageButton_Click"
                                            AutomationProperties.Name="{DynamicResource Portable.ChoosePackageName}"/>
                                </Grid>

                                <Border Padding="10"
                                        Background="{DynamicResource InsetSurfaceBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <TextBox x:Name="ImportPreviewBox"
                                             MinHeight="235"
                                             IsReadOnly="True"
                                             IsReadOnlyCaretVisible="True"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             Background="Transparent"
                                             BorderThickness="0" Padding="2"
                                             Foreground="{DynamicResource TextBrush}"
                                             FontFamily="Segoe UI Variable Text"
                                             FontSize="11" TextBlock.LineHeight="17"
                                             Text="{DynamicResource Portable.ImportNoPackage}"
                                             AutomationProperties.Name="{DynamicResource Portable.ImportPreviewName}"
                                             AutomationProperties.HelpText="{DynamicResource Portable.ImportPreviewHelp}"/>
                                </Border>

                                <CheckBox x:Name="ImportKeyboardAcknowledgementCheckBox"
                                          Margin="2,10,2,0"
                                          Visibility="Collapsed"
                                          Checked="ImportAcknowledgementCheckBox_Changed"
                                          Unchecked="ImportAcknowledgementCheckBox_Changed"
                                          Content="{DynamicResource Portable.ImportKeyboardConfirmation}"
                                          AutomationProperties.Name="{DynamicResource Portable.ImportKeyboardConfirmationName}"/>

                                <CheckBox x:Name="ImportTopologyAcknowledgementCheckBox"
                                          Margin="2,9,2,0"
                                          Visibility="Collapsed"
                                          Checked="ImportAcknowledgementCheckBox_Changed"
                                          Unchecked="ImportAcknowledgementCheckBox_Changed"
                                          Content="{DynamicResource Portable.ImportTopologyConfirmation}"
                                          AutomationProperties.Name="{DynamicResource Portable.ImportTopologyConfirmationName}"/>

                                <CheckBox x:Name="ImportConfirmationCheckBox"
                                          Margin="2,9,2,0"
                                          IsEnabled="False"
                                          Checked="ImportAcknowledgementCheckBox_Changed"
                                          Unchecked="ImportAcknowledgementCheckBox_Changed"
                                          Content="{DynamicResource Portable.ImportConfirmation}"
                                          AutomationProperties.Name="{DynamicResource Portable.ImportConfirmationName}"/>

                                <Border Margin="0,10,0,0" Padding="11,9"
                                        Background="{DynamicResource WarningSurfaceBrush}"
                                        BorderBrush="{DynamicResource WarningBorderBrush}"
                                        BorderThickness="1" CornerRadius="9">
                                    <TextBlock Text="{DynamicResource Portable.ImportPrivacyReminder}"
                                               Foreground="{DynamicResource WarningMutedTextBrush}"
                                               FontSize="10" LineHeight="15"
                                               TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ImportStatusText"
                                       Text="{DynamicResource Portable.ImportInitialStatus}"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontSize="11" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Margin="0,0,12,0"
                                       AutomationProperties.LiveSetting="Polite"/>
                            <Button x:Name="ConfirmImportButton"
                                    Grid.Column="1"
                                    Content="{DynamicResource Portable.ImportButton}"
                                    IsEnabled="False" Padding="14,8"
                                    Click="ConfirmImportButton_Click"
                                    AutomationProperties.Name="{DynamicResource Portable.ImportButtonName}"
                                    AutomationProperties.HelpText="{DynamicResource Portable.ImportButtonHelp}"/>
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="LegacyMetadataButton"
                        Content="{DynamicResource Portable.LegacyButton}"
                        HorizontalAlignment="Left" Padding="12,8"
                        Background="{DynamicResource ControlSurfaceBrush}"
                        Foreground="{DynamicResource ControlTextBrush}"
                        Click="LegacyMetadataButton_Click"
                        AutomationProperties.Name="{DynamicResource Portable.LegacyButtonName}"
                        AutomationProperties.HelpText="{DynamicResource Portable.LegacyButtonHelp}"/>
                <Button x:Name="DoneButton" Grid.Column="1"
                        Content="{DynamicResource Common.Done}" IsCancel="True"
                        HorizontalAlignment="Right" Padding="15,8"
                        Background="{DynamicResource ControlSurfaceBrush}"
                        Foreground="{DynamicResource ControlTextBrush}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
